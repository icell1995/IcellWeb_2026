<?php

namespace App\Http\Controllers\IcellServices\ApiEmpBareskrim\V2\Doc;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;
use Carbon\Carbon;

class SuratKetetapanTentangPenetapanTersangkaDocumentController extends Controller
{
    public function index(Request $request){
        // Get request data
        $startDocumentDate = $request->input('start_doc_date');
        $endDocumentDate = $request->input('end_doc_date');
        $perPage = $request->query('perPage', 100); // Jumlah item per halaman
        $page = $request->query('page', 1); // Nomor halaman saat ini, default 1

        // Initialize variable
        $responseData = [];

        if (!is_numeric($page)) {
            // Jika $page bukan angka, berikan nilai default 1
            $page = 1;
        }

        if (!is_numeric($perPage)) {
            // Jika $page bukan angka, berikan nilai default 1
            $perPage = 100;
        }

        $page = intval($page);

        // Validate request data
        if (!empty($startDocumentDate) && date('Y-m-d', strtotime($startDocumentDate)) !== $startDocumentDate) {
            return response()->json([
                "code" => "400",
                "status" => "BAD_REQUEST",
                "message" => "Invalid Start document date or format. Date format should be YYYY-MM-DD.",
                "pagination" => [
                    "Page" => intval($page),
                    "TotalData" => 0,
                    "TotalPage" => 0,
                    "TotalDataSent" => 0
                ],
                "data" => []
            ], 400);
        }

        if (!empty($endDocumentDate) && date('Y-m-d', strtotime($endDocumentDate)) !== $endDocumentDate) {
            return response()->json([
                "code" => "400",
                "status" => "BAD_REQUEST",
                "message" => "Invalid End document date or format. Date format should be YYYY-MM-DD.",
                "pagination" => [
                    "Page" => intval($page),
                    "TotalData" => 0,
                    "TotalPage" => 0,
                    "TotalDataSent" => 0
                ],
                "data" => []
            ], 400);
        }

        DB::beginTransaction();
        try {
            // Get data from database
            $suspectDeterminationDecisionLetters = SuspectDeterminationDecisionLetter::with(['accident', 'authorizedSignatory'])
                                                                                    ->orderBy('letter_date', 'asc');                      

            // Filter data
            if (!empty($startDocumentDate) && !empty($endDocumentDate)) {
                $suspectDeterminationDecisionLetters = $suspectDeterminationDecisionLetters->whereBetween('letter_date', [date('Y-m-d H:i:s', strtotime($startDocumentDate)), date('Y-m-d H:i:s', strtotime($endDocumentDate))]);
            } else if (!empty($startDocumentDate)) {
                $suspectDeterminationDecisionLetters = $suspectDeterminationDecisionLetters->where('letter_date', '>=', date('Y-m-d H:i:s', strtotime($startDocumentDate)));
            } else if (!empty($endDocumentDate)) {
                $suspectDeterminationDecisionLetters = $suspectDeterminationDecisionLetters->where('letter_date', '<=', date('Y-m-d H:i:s', strtotime($endDocumentDate)));
            }
            $suspectDeterminationDecisionLetters = $suspectDeterminationDecisionLetters ->paginate($perPage, ['*'], 'page', $page);

            $suspectDeterminationDecisionLettersTotal = $suspectDeterminationDecisionLetters->total();
            $suspectDeterminationDecisionLettersTotalPage = $suspectDeterminationDecisionLetters->lastPage();

            // Packing data
            $arrayKey = 0;
            foreach ($suspectDeterminationDecisionLetters as $suspectDeterminationDecisionLetter) {
                
                $suspectDeterminationDecisionLetterArray = $suspectDeterminationDecisionLetter->toArray();

                $authorizedSignatory = (!empty($suspectDeterminationDecisionLetterArray['authorized_signatory'])) ? $suspectDeterminationDecisionLetterArray['authorized_signatory'] : null;
                $accident = (!empty($suspectDeterminationDecisionLetterArray['accident'])) ? $suspectDeterminationDecisionLetterArray['accident'] : null;
                
                $documentSignatory[0] = [
                    "Nama" => ($authorizedSignatory) ? $authorizedSignatory['first_title'] . " " . strtoupper($authorizedSignatory['first_name'] . " " . $authorizedSignatory['last_name']) . ", " . $authorizedSignatory['last_title'] : null,
                    "Pangkat" => ($authorizedSignatory) ? strtoupper($authorizedSignatory['ranks_id']) : null,
                    "NRP" => ($authorizedSignatory) ? strval($authorizedSignatory['register_number']) : null, 
                    "Jabatan" => ($authorizedSignatory) ? strtoupper($authorizedSignatory['position_id']) : null,
                ];

                $responseData[$arrayKey] = [
                    "Id" => $suspectDeterminationDecisionLetter->id,
                    "NomorSurat" => $suspectDeterminationDecisionLetter->letter_number,
                    "TanggalSurat" => ($suspectDeterminationDecisionLetter->letter_date) ? date('Y-m-d', strtotime($suspectDeterminationDecisionLetter->letter_date)) : null,
                    "LaporanPolisiID" => ($accident) ? strval($accident['id']) : null,
                    "DorsID" => ($accident) ? strval($accident['dors_id']) : null,
                    "SprindikId" => $suspectDeterminationDecisionLetter->investigation_report_id,
                    "KejaksaanId" => $suspectDeterminationDecisionLetter->prosecutor_office_id,
                    "SumberTersangka" => "Tersangka Baru",
                    "PejabatPenandatanganDokumen" => $documentSignatory,
                    "LHGP_Id" => $suspectDeterminationDecisionLetter->investigation_warrant_id,
                ];

                $suspectDeterminationDecisionLetterId = $suspectDeterminationDecisionLetter->id;
                DB::table('suspect_determination_decision_letters')
                    ->where('id', $suspectDeterminationDecisionLetterId)
                    ->update([
                        'integrated_at' => date('Y-m-d H:i:s'),
                ]);

                $arrayKey++;
            }
       
            // Check if data array is empty result
            if ($suspectDeterminationDecisionLetters->isEmpty()) {
                return response()->json([
                    "code" => "404",
                    "status" => "NOT_FOUND",
                    "message" => "Data not found.",
                    "pagination" => [
                        "Page" => intval($page),
                        "TotalData" => 0,
                        "TotalPage" => 0,
                        "TotalDataSent" => 0
                    ],
                    "data" => []
                ], 404);
            }

            // Commit transaction
            DB::commit();

            // Return Result JSON
            return response()->json([
                "code" => "200",
                "status" => "OK",
                "message" => "Success",
                "pagination" => [
                    "Page" => intval($page),
                    "TotalData" => $suspectDeterminationDecisionLettersTotal,
                    "TotalPage" => $suspectDeterminationDecisionLettersTotalPage,
                    "TotalDataSent" => count($responseData)
                ],
                "data" => $responseData
            ], 200);
            
        } catch (\Exception $e) {
            DB::rollback();
            // If an exception occurs, return an error response
            return response()->json([
                "code" => "500",
                "status" => "INTERNAL_SERVER_ERROR",
                "message" => "An error occurred while processing your request.",
                "pagination" => [
                    "Page" => intval($page),
                    "TotalData" => 0,
                    "TotalPage" => 0,
                    "TotalDataSent" => 0
                ],
                "data" => []
            ], 500);
        }
    }

    private function collectionData(){
        $start_date = Carbon::create(2022, 1, 1);
        $end_date = Carbon::create(2022, 12, 31);
        $data = [];

        $no = 1;
        for ($date = $start_date; $date <= $end_date; $date->modify('+1 day')) {
            $data[] = [
                "Id" => Str::uuid(),
                "NomorSurat" => "SURAT/SKTPT/" . $no . "/2022",
                "TanggalSurat" => $date->format('Y-m-d H:i:s'),
                "LaporanPolisiID" => Str::uuid(),
                "DorsID" => strval(rand(1000000,9999999)),
                "SprindikId" => Str::uuid(),
                "KejaksaanId" => 3,
                "SumberTersangka" => "Tersangka Baru",
                "PejabatPenandatanganDokumen" => [
                    [
                        "Nama" => "Dewi Kusuma, S.Sos",
                        "Pangkat" => "AKBP",
                        "NRP" => "77062975",
                        "Jabatan" => "KASAT LANTAS",
                    ],
                ],
                "LHGP_Id" => Str::uuid(),
            ];

            $no++;
        }

        return collect($data);
    }
}


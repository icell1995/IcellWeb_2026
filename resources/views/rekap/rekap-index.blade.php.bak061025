@push('script')
<script type="text/javascript">
    $("#date_from").datepicker({
        format  : 'dd-mm-yyyy'
    });

    $("#tglKejadian").datepicker({
        format  : 'dd-mm-yyyy'
    });

    $("#date_to").datepicker({
        format  : 'dd-mm-yyyy'
    });

    $(document).ready(function(){
    var get_pol = $('#polda').val();
        if( get_pol == null || get_pol == '-'){
            $('#polres').prop('disabled', true);
        }else{
            $('#polres').prop('disabled', false);
        }
    });
    $(".RekapExport").click(function(e){
        e.preventDefault();
        var polda = $('#polda').val();
        if( polda == null || polda == '-'){
            $('#polres').prop('disabled', true);
        }else{
            $('#polres').prop('disabled', false);
        }
        var no_lp = $("#no_LP").val();
        var date_from = $("#date_from").val();
        var date_to = $("#date_to").val();
        var status = $("#status").val();
        var polres = $("#polres").val();
        alert(date_to);
        window.location = "{{route('ExportRekap')}}"+ '?no_lp=' +no_lp+ '&polres=' +polres+ '&polda=' +polda+ '&status=' +status+
        '&date_from=' +date_from+ '&date_to=' +date_to
    })

    $('#polda').on('change', function(event) {
        event.preventDefault();
        var poldaId = $(this).val();
        $('#polres').prop('disabled', true);
        $('#polres').empty();
        $('#polres').append('<option value="">Pilih Polres</option>');
        if (!poldaId) {
            return;
        }

        $.get('{{ url('pengguna/polres_list') }}/' + poldaId, function(data) {

            $('#polres').empty()
            var option = '<option value="">Pilih Polres</option>';
            $('#polres').append(option);

            $.each(data, function(key, polres) {
                var id = polres.id;
                var name = polres.name;
                var option = '<option value="' + id + '">' + name + '</option>';

                $('#polres').append(option);
            });

            $('#polres').prop('disabled', false);
        });
    });

    $('#search_btn').click(function(){
            $('#polres').prop('disabled',false);
        });
</script>

@endpush


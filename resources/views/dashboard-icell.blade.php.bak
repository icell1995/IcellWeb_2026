<script type="text/javascript">

    $(document).ready(function() {
        const colors = Highcharts.getOptions().colors.map((color) => {
            let newColor = new Highcharts.Color(color).brighten(-0.3).get('rgb');
            return {
                radialGradient: { cx: 0.5, cy: 0.3, r: 0.7 },
                stops: [
                    [0, color],
                    [1, newColor] // darken
                ]
            }
        });

        var dashBarChart;
        var dashPieChart;
        var dashPie2Chart;

        function loadDashBarChart() {
            if(dashBarChart){
                dashBarChart.destroy();
                dashBarChart = null;
            }
            $.ajax({
                url: "{{ route('getDashBar') }}",
                type: 'get',
                success: function(data) {
                    var get_date = new Array();
                    var get_count = new Array();
                    a = data.length;
                    // alert(a);
                    for (x = 0; x < a; x++) {
                        get_date.push([data[x].date]);
                        get_count.push([data[x].count]);
                    }
                    // alert(get_date);

                    dashBarChart = Highcharts.chart('dashBar', {
                        chart: {
                            height: 358,
                            type: 'column',
                            options3d: {
                                enabled: true,
                                alpha: 15,
                                beta: 5,
                                depth: 25,
                                viewDistance: 50
                            }
                        },
                        title: {
                            text: 'Jumlah LP Ditindaklanjuti Per-Bulan',
                            style: {
                                fontWeight: 'bold',
                                fontSize: '20px'
                            }
                        },
                        accessibility: {
                            announceNewData: {
                                enabled: true
                            }
                        },
                        xAxis: {
                            type: 'category'
                        },
                        yAxis: {
                            title: {
                                text: 'Jumlah'
                            }
                        },
                        legend: {
                            enabled: false
                        },
                        plotOptions: {
                            series: {
                                borderWidth: 0,
                                dataLabels: {
                                    enabled: true
                                }
                            }
                        },

                        tooltip: {
                            headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                            pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y}</b><br/>'
                        },

                        series: [{
                            name: "Jumlah Laka Lantas Sedang Ditindak Lanjuti",
                            colorByPoint: true,
                            data: [{
                                    name: get_date[0],
                                    y: parseInt(get_count[0])
                                    // y: 20
                                },
                                {
                                    name: get_date[1],
                                    y: parseInt(get_count[1])
                                    // y: 12
                                },
                                {
                                    name: get_date[2],
                                    y: parseInt(get_count[2])
                                    // y: 4
                                },
                                {
                                    name: get_date[3],
                                    y: parseInt(get_count[3])
                                    // y: 15
                                },
                                {
                                    name: get_date[4],
                                    y: parseInt(get_count[4])
                                    // y: 25
                                },
                                {
                                    name: get_date[5],
                                    y: parseInt(get_count[5])
                                    // y: 22
                                },
                                {
                                    name: get_date[6],
                                    y: parseInt(get_count[6])
                                    // y: 9
                                },
                                {
                                    name: get_date[7],
                                    y: parseInt(get_count[7])
                                    // y: 16
                                },
                                {
                                    name: get_date[8],
                                    y: parseInt(get_count[8])
                                    // y: 26
                                },
                                {
                                    name: get_date[9],
                                    y: parseInt(get_count[9])
                                    // y: 14
                                },
                                {
                                    name: get_date[10],
                                    y: parseInt(get_count[10])
                                    // y: 5
                                },
                                {
                                    name: get_date[11],
                                    y: parseInt(get_count[11])
                                    // y: 2
                                },
                            ]
                        }]
                    });

                    Highcharts.setOptions({
                        colors: Highcharts.map(Highcharts.getOptions().colors, function(color) {
                            return {
                                radialGradient: {
                                    cx: 0.5,
                                    cy: 0.3,
                                    r: 0.7
                                },
                                stops: [
                                    [0, color],
                                    [1, Highcharts.color(color).brighten(-0.3).get(
                                        'rgb')] // darken
                                ]
                            };
                        })
                    });
                },
                error: function(jqXHR, textStatus, errorThrown) {
                    console.error('AJAX Error:', textStatus, errorThrown);
                }
            });
        }

        function loadPieChart() {
            if(dashPieChart){
                dashPieChart.destroy();
                dashPie2Chart.destroy();
                dashPieChart = null;
                dashPie2Chart = null;
            }

            $.ajax({
                url: "{{ route('getDashPie') }}",
                type: 'get',
                success: function(data) {
                    var get_month = new Array();
                    var get_year = new Array();
                    var get_lastYear = new Array();
                    var get_jumlah = new Array();
                    var get_jumlah_lastYear = new Array();
                    var get_selra = new Array();
                    var get_percentage = new Array();
                    var get_selra_lastYear = new Array();
                    var get_percentage_lastYear = new Array();

                    a = data[0].jumlah_selra.length;
                    for (x = 0; x < a; x++) {
                        get_selra.push([data[0].jumlah_selra[x].name]);
                        get_percentage.push([data[0].jumlah_selra[x].percentage]);
                    };

                    b = data[0].jumlah_selra_lastYear.length;
                    for (x = 0; x < b ; x++) {
                        get_selra_lastYear.push([data[0].jumlah_selra_lastYear[x].name]);
                        get_percentage_lastYear.push([data[0].jumlah_selra_lastYear[x].percentage_lastyear]);
                    };

                    get_month.push([data[0].date_month]);
                    get_year.push([data[0].date_year]);
                    get_lastYear.push([data[0].lastYear]);
                    get_jumlah.push([data[0].jumlah_laka]);
                    get_jumlah_lastYear.push([data[0].jumlah_laka_lastYear]);

                    // console.log(get_percentage_lastYear);

                    dashPieChart = Highcharts.chart('dashPie', {
                        chart: {
                            height: 358,
                            plotBackgroundColor: null,
                            plotBorderWidth: null,
                            plotShadow: false,
                            type: 'pie',
                            options3d: {
                                enabled: true,
                                alpha: 45
                            }
                        },
                        title: {
                            text: 'Jumlah SELRA Tahun ' + get_year[0] + ' Sebanyak : ' +
                                get_jumlah[0] + ' LP',
                            style: {
                                fontWeight: 'bold'
                            }
                        },
                        subtitle: {
                            text: '( Berdasarkan Tanggal Tindak Lanjut Tahun ' + get_year[0] + ' )',
                            style: {
                                fontWeight: 'bold',
                                fontSize: '14px'
                            }
                        },
                        tooltip: {
                            pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
                        },
                        accessibility: {
                            point: {
                                valueSuffix: '%'
                            }
                        },
                        plotOptions: {
                            pie: {
                                allowPointSelect: true,
                                cursor: 'pointer',
                                innerSize : 100,
                                depth : 45,
                                dataLabels: {
                                    enabled: true,
                                    format: '<b>{point.name}</b>: {point.percentage:.1f} %',
                                    connectorColor: 'silver'
                                }
                            }
                        },
                        series: [{
                            name: 'Persentase',
                            data: [{
                                    name: get_selra[0],
                                    y: parseFloat(get_percentage[0])
                                    // y: 30
                                },
                                {
                                    name: get_selra[1],
                                    y: parseFloat(get_percentage[1])
                                    // y: 24
                                },
                                {
                                    name: get_selra[2],
                                    y: parseFloat(get_percentage[2])
                                    // y: 11
                                },
                                {
                                    name: get_selra[3],
                                    y: parseFloat(get_percentage[3])
                                    // y: 17
                                },
                                {
                                    name: get_selra[4],
                                    y: parseFloat(get_percentage[4])
                                    // y: 6
                                },
                            ]
                        }]
                    });

                    dashPie2Chart = Highcharts.chart('dashPie2', {
                        chart: {
                            height: 358,
                            plotBackgroundColor: null,
                            plotBorderWidth: null,
                            plotShadow: false,
                            type: 'pie',
                            options3d: {
                                enabled: true,
                                alpha: 45
                            }
                        },
                        title: {
                            text: 'Jumlah SELRA Tahun ' + get_lastYear[0] + ' Sebanyak : ' +
                            get_jumlah_lastYear[0] + ' LP',
                            style: {
                                fontWeight: 'bold'
                            }
                        },
                        subtitle: {
                            text: '( Berdasarkan Tanggal Tindak Lanjut Tahun ' + get_lastYear[0] + ' )',
                            style: {
                                fontWeight: 'bold',
                                fontSize: '14px'
                            }
                        },
                        tooltip: {
                            pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
                        },
                        accessibility: {
                            point: {
                                valueSuffix: '%'
                            }
                        },
                        plotOptions: {
                            pie: {
                                allowPointSelect: true,
                                cursor: 'pointer',
                                innerSize : 100,
                                depth : 45,
                                dataLabels: {
                                    enabled: true,
                                    format: '<b>{point.name}</b>: {point.percentage:.1f} %',
                                    connectorColor: 'silver'
                                }
                            }
                        },
                        series: [{
                            name: 'Persentase',
                            data: [{
                                    name: get_selra_lastYear[0],
                                    y: parseFloat(get_percentage_lastYear[0])
                                    // y: 30
                                },
                                {
                                    name: get_selra_lastYear[1],
                                    y: parseFloat(get_percentage_lastYear[1])
                                    // y: 24
                                },
                                {
                                    name: get_selra_lastYear[2],
                                    y: parseFloat(get_percentage_lastYear[2])
                                    // y: 11
                                },
                                {
                                    name: get_selra_lastYear[3],
                                    y: parseFloat(get_percentage_lastYear[3])
                                    // y: 17
                                },
                                {
                                    name: get_selra_lastYear[4],
                                    y: parseFloat(get_percentage_lastYear[4])
                                    // y: 6
                                },
                            ]
                        }]
                    });
                },
                error: function(jqXHR, textStatus, errorThrown) {
                    console.error('AJAX Error:', textStatus, errorThrown);
                }
            });
        }

        loadDashBarChart();
        loadPieChart();

        function updateContent() {
            $.ajax({
                url: "{{ route('updateContent') }}",
                type: 'get',
                success: function(data) {
                    //Memperbarui Total DORS
                    $('#dorsCount').html(data.countDORS);

                    // Memperbarui total
                    $('#totalCard').html(data.totalall);

                    // Memperbarui total SELRA
                    $('#selraCard').html(data.total_selra);

                    // Memperbarui DPO
                    $('#dpoCard').html(data.dpo);

                    // Memperbarui DPB
                    $('#dpbCard').html(data.dpb);

                    console.log('Content updated successfully');
                },
                error: function(error) {
                    console.error('Error updating content', error);
                }
            });
        }

        setInterval(function() {
            // loadDashBarChart();
            // loadPieChart();
            updateContent();
        }, 60000);

        setTimeout(function(){
    	    location.reload();
    	}, 900000);


        $('.dataTable').DataTable({
            responsive: true,
            "pageLength": 15,
            "lengthMenu": [ 15, 25, 50, 75, 100 ]
        });
    });

</script>

</html>

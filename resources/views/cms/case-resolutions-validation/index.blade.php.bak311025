<script>
  function initDatepickersSimple() {
    const opts = {
      format: 'dd-mm-yyyy',     // SAMA dengan value di Blade
      autoclose: true,
      todayHighlight: true,
      orientation: 'bottom auto',
      container: 'body',
      endDate: new Date()       // batasi sampai hari ini
    };

    // Init
    $('#filter_from, #filter_to').datepicker(opts);

    // Buka datepicker saat klik ikon/label
    $('.input-group-text').on('click', function () {
      const $target = $(this).nextAll('input.form-control').first();
      if ($target.length) $target.datepicker('show');
    });

    // Klik input juga buka
    $('#filter_from, #filter_to').on('click', function () {
      $(this).datepicker('show');
    });
  }

  document.addEventListener('DOMContentLoaded', initDatepickersSimple);
</script>

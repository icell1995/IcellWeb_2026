@push('script')
  <script src="{{ asset('libs/sweetalert/sweetalert2.all.min.js') }}"></script>
  <script>
    /**
     * ========================================
     * GLOBAL CONFIGURATION
     * ========================================
     */
    const APP_CONFIG = {
      routes: {
        index: "{{ route('cms.case-resolutions-validations.index') }}"
      },
      timing: {
        successDelay: 1000,
      }
    };

    /**
     * ========================================
     * PDF Preview Fullscreen Toggle
     * ========================================
     */
    (function initFullscreenToggle() {
      const preview   = document.getElementById('pdfPreview');
      const toggleBtn = document.querySelector('.js-toggle-full');
      
      if (!preview || !toggleBtn) return;

      function toggleFullscreen() {
        const isFullscreen = preview.classList.toggle('fullscreen');
        document.body.classList.toggle('no-scroll', isFullscreen);
        toggleBtn.innerHTML = isFullscreen
          ? '<i class="bi bi-fullscreen-exit"></i> Kecilkan'
          : '<i class="bi bi-arrows-fullscreen"></i> Perbesar';
      }
      
      toggleBtn.addEventListener('click', toggleFullscreen);
      
      // ESC key to exit fullscreen
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && preview.classList.contains('fullscreen')) {
          toggleFullscreen();
        }
      });
    })();

    /**
     * ========================================
     * Helper: Close Current Browser Tab
     * ========================================
     */
    function closeCurrentTab() {
      setTimeout(() => {
        // Method 1: Standard close
        window.close();
        
        // Method 2: Force close dengan open blank
        setTimeout(() => {
          window.open('about:blank', '_self');
          window.close();
        }, 100);
      }, APP_CONFIG.timing.successDelay);
    }

    /**
     * ========================================
     * Helper: Submit Form via AJAX
     * ========================================
     */
    function submitFormAjax(form, loadingMessage = 'Memproses...') {
      const formData = new FormData(form);
      const url = form.action;
      const method = form.method || 'POST';

      // Show loading
      Swal.fire({
        title: loadingMessage,
        html: 'Mohon tunggu sebentar...',
        allowOutsideClick: false,
        allowEscapeKey: false,
        allowEnterKey: false,
        showConfirmButton: false,
        didOpen: () => {
          Swal.showLoading();
        }
      });

      // Submit via fetch
      fetch(url, {
        method: method,
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json',
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Show success message
          Swal.fire({
            icon: 'success',
            title: 'Berhasil',
            text: data.message,
            showConfirmButton: false,
            timer: APP_CONFIG.timing.successDelay,
            timerProgressBar: true,
            allowOutsideClick: false
          }).then(() => {
            // Check action
            if (data.action === 'close_tab') {
              closeCurrentTab();
            } else if (data.action === 'redirect' && data.url) {
              window.location.href = data.url;
            }
          });
        } else {
          // Show error
          Swal.fire({
            icon: 'error',
            title: 'Gagal',
            text: data.message || 'Terjadi kesalahan',
            confirmButtonText: 'OK',
            confirmButtonColor: '#d33'
          }).then(() => {
            if (data.action === 'redirect' && data.url) {
              window.location.href = data.url;
            }
          });
        }
      })
      .catch(error => {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Terjadi Kesalahan',
          text: 'Tidak dapat memproses permintaan',
          confirmButtonText: 'OK',
          confirmButtonColor: '#d33'
        });
      });
    }

    /**
     * ========================================
     * Approve Form Handler
     * ========================================
     */
    (function initApproveForm() {
      document.querySelectorAll('form.js-approve').forEach(form => {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          
          Swal.fire({
            icon: 'question',
            title: 'Setujui Selra ini?',
            text: 'Pastikan data sudah benar.',
            showCancelButton: true,
            confirmButtonText: 'Ya, Setujui',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#198754',
            cancelButtonColor: '#6c757d'
          }).then(result => {
            if (result.isConfirmed) {
              submitFormAjax(form, 'Menyetujui dokumen...');
            }
          });
        });
      });
    })();

    /**
     * ========================================
     * Reject Form Handler
     * ========================================
     */
    (function initRejectForm() {
      document.querySelectorAll('form.js-reject').forEach(form => {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          
          Swal.fire({
            icon: 'warning',
            title: 'Kembalikan Selra ini?',
            html: 'LP akan di-set menjadi Dalam Proses dan data Selra akan <b>dihapus</b>.<br><br>Masukkan alasan (opsional):',
            input: 'textarea',
            inputPlaceholder: 'Tulis alasan dikembalikan…',
            inputAttributes: { 
              'aria-label': 'Alasan dikembalikan' 
            },
            showCancelButton: true,
            confirmButtonText: 'Ya, Kembalikan',
            cancelButtonText: 'Batal',
            confirmButtonColor: '#f39c12',
            cancelButtonColor: '#6c757d'
          }).then(result => {
            if (result.isConfirmed) {
              const hiddenInput = form.querySelector('input[name="reject_reason"]');
              if (hiddenInput) {
                hiddenInput.value = result.value || '';
              }
              submitFormAjax(form, 'Mengembalikan dokumen...');
            }
          });
        });
      });
    })();

    /**
     * ========================================
     * Initialize Bootstrap Tooltips
     * ========================================
     */
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(element) {
        new bootstrap.Tooltip(element);
      });
    });
  </script>
@endpush

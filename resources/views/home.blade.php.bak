    <script type="text/javascript">
        $(document).ready(function() {
            $('#announcementText').modal('show');
        });

        setInterval(function() {
            $('.marked-column').toggleClass('bg-white bg-danger text-white text-black');
        }, 2000);
    </script>

    <script type="text/javascript">
        // window.onload = function(){

        $.ajax({
            url: "{{ route('getChartBulan') }}",
            type: 'get',
            success: function(data) {
                var get_date = new Array();
                var get_count = new Array();
                a = data.length;
                // alert(a);
                for (x = 0; x < a; x++) {
                    get_date.push([data[x].date]);
                    get_count.push([data[x].count]);
                }
                // alert(get_date);

                Highcharts.chart('chartBar', {
                    chart: {
                        height: 358,
                        type: 'column',
                        options3d: {
                            enabled: true,
                            alpha: 15,
                            beta: 5,
                            depth: 25,
                            viewDistance: 50
                        }
                    },
                    title: {
                        text: 'Jumlah LP Ditindaklanjuti Per-Bulan',
                        style: {
                            fontWeight: 'bold',
                            fontSize: '20px'
                        }
                    },
                    // subtitle: {
                    //     text: 'Jumlah Laka Sidik',
                    //     style: {
                    //         fontWeight: 'bold',
                    //         fontSize: '14px'
                    //     }
                    // },
                    accessibility: {
                        announceNewData: {
                            enabled: true
                        }
                    },
                    xAxis: {
                        type: 'category'
                    },
                    yAxis: {
                        title: {
                            text: 'Jumlah'
                        }

                    },
                    legend: {
                        enabled: false
                    },
                    plotOptions: {
                        series: {
                            borderWidth: 0,
                            dataLabels: {
                                enabled: true
                            }
                        }
                    },

                    tooltip: {
                        headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                        pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y}</b><br/>'
                    },

                    series: [{
                        name: "Jumlah Laka Lantas Sedang Ditindak Lanjuti",
                        colorByPoint: true,
                        data: [{
                                name: get_date[0],
                                y: parseInt(get_count[0])
                                // y: 20
                            },
                            {
                                name: get_date[1],
                                y: parseInt(get_count[1])
                                // y: 12
                            },
                            {
                                name: get_date[2],
                                y: parseInt(get_count[2])
                                // y: 4
                            },
                            {
                                name: get_date[3],
                                y: parseInt(get_count[3])
                                // y: 15
                            },
                            {
                                name: get_date[4],
                                y: parseInt(get_count[4])
                                // y: 25
                            },
                            {
                                name: get_date[5],
                                y: parseInt(get_count[5])
                                // y: 22
                            },
                            {
                                name: get_date[6],
                                y: parseInt(get_count[6])
                                // y: 9
                            },
                            {
                                name: get_date[7],
                                y: parseInt(get_count[7])
                                // y: 16
                            },
                            {
                                name: get_date[8],
                                y: parseInt(get_count[8])
                                // y: 26
                            },
                            {
                                name: get_date[9],
                                y: parseInt(get_count[9])
                                // y: 14
                            },
                            {
                                name: get_date[10],
                                y: parseInt(get_count[10])
                                // y: 5
                            },
                            {
                                name: get_date[11],
                                y: parseInt(get_count[11])
                                // y: 2
                            },
                        ]
                    }]
                });

                Highcharts.setOptions({
                    colors: Highcharts.map(Highcharts.getOptions().colors, function(color) {
                        return {
                            radialGradient: {
                                cx: 0.5,
                                cy: 0.3,
                                r: 0.7
                            },
                            stops: [
                                [0, color],
                                [1, Highcharts.color(color).brighten(-0.3).get(
                                    'rgb')] // darken
                            ]
                        };
                    })
                });

            }
        });


        $.ajax({
            url: "{{ route('getPieBulan') }}",
            type: 'get',
            success: function(data) {
                // var get_date = new Array();
                // var get_percentage = new Array();
                var get_month = new Array();
                var get_year = new Array();
                var get_jumlah = new Array();
                var get_selra = new Array();
                var get_percentage = new Array();

                a = data[0].jumlah_selra.length;
                for (x = 0; x < a; x++) {
                    get_selra.push([data[0].jumlah_selra[x].name]);
                    get_percentage.push([data[0].jumlah_selra[x].percentage]);
                }
                // for(x=0; x< a; x++){
                // get_date.push([data[x].date]);
                // get_percentage.push([data[x].percentage]);
                get_month.push([data[0].date_month]);
                get_year.push([data[0].date_year]);
                get_jumlah.push([data[0].jumlah_laka]);
                // }
                Highcharts.chart('chartPie', {
                    chart: {
                        height: 358,
                        plotBackgroundColor: null,
                        plotBorderWidth: null,
                        plotShadow: false,
                        type: 'pie',
                        options3d: {
                            enabled: true,
                            alpha: 50,
                            beta: 0
                        }
                    },
                    title: {
                        // text: 'Jumlah Laka Sidik Bulan '+get_date[0]+' sampai '+get_date[11]+' sebanyak : '+get_jumlah[0]+' laka'
                        //text: 'Jumlah SELRA Bulan Januari '+get_year[0]+' sampai '+get_month[0]+' '+get_year[0]+' sebanyak : '+get_jumlah[0]+' laka',
                        text: 'Jumlah SELRA Tahun ' + get_year[0] + ' sebanyak : ' + get_jumlah[0] +
                            ' LP',
                        style: {
                            fontWeight: 'bold'
                        }
                    },
                    subtitle: {
                        text: '( Berdasarkan Tanggal Tindak Lanjut Tahun ' + get_year[0] + ' )',
                        style: {
                            fontWeight: 'bold',
                            fontSize: '14px'
                        }
                    },
                    tooltip: {
                        pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
                    },
                    accessibility: {
                        point: {
                            valueSuffix: '%'
                        }
                    },
                    plotOptions: {
                        pie: {
                            allowPointSelect: true,
                            cursor: 'pointer',
                            depth: 35,
                            dataLabels: {
                                enabled: true,
                                format: '<b>{point.name}</b>: {point.percentage:.1f} %',
                                connectorColor: 'silver'
                            }
                        }
                    },
                    series: [{
                        name: 'Persentase',
                        data: [{
                                name: get_selra[0],
                                y: parseFloat(get_percentage[0])
                                // y: 30
                            },
                            {
                                name: get_selra[1],
                                y: parseFloat(get_percentage[1])
                                // y: 24
                            },
                            {
                                name: get_selra[2],
                                y: parseFloat(get_percentage[2])
                                // y: 11
                            },
                            {
                                name: get_selra[3],
                                y: parseFloat(get_percentage[3])
                                // y: 17
                            },
                            {
                                name: get_selra[4],
                                y: parseFloat(get_percentage[4])
                                // y: 6
                            },
                            {
                                name: get_selra[5],
                                y: parseFloat(get_percentage[5])
                                // y: 25
                            },
                            // {
                            //     name: get_selra[6],
                            //     y: parseFloat(get_percentage[6])
                            //     // y: 34
                            // },
                        ]

                    }]
                });
            }
        });
        // Build the chart
    </script>

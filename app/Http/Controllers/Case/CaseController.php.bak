<?php

namespace App\Http\Controllers\Case;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;

use App\Models\Accident;
use App\Models\CaseVehicle;
use App\Models\UploadSuratKetetapan;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Auth;

class CaseController extends Controller
{
    public function index()
    {
        $userAuth = Auth::user();
        $collection = NULL;

        $cases = Http::withHeaders([
            'Key' => '9xEVPyQE26KTpo5h6DxwW34m2TkUGnqD243b1i4BNs3C7yg3dL4Ynql3ehRsfZbsQubzRR51BTudsPeMFRtkLBGiennZ0TojmmK9=getDataJatanlin',
            'Content-Type' => 'application/json',
        ])
            ->get('https://irsms.korlantas.polri.go.id/irsmsapi/api/getDataJatanlin')->json();

        if(isset($cases['result'])){
            $collection = collect($cases['result']);

            if(in_array($userAuth->role_id, [3, 4, 5])){
                $cases['result'] = $collection->where('polres_id', $userAuth->polres_id);
            }
        }

        return view('case.index', compact('cases'));
    }

    public function show($id)
    {
        $case = Http::withHeaders([
            'Key' => '3b1i4BNs3C7y1BTudsPeMFRtkLBGiennZ0Tojg3dL4Ynql3ehRsfZbsQubzRR5mmK99xEVPyQE26KTpo5h6DxwW34m2TkUGnqD24=getDetailJatanlin',
            'Content-Type' => 'application/json',
        ])
            ->withBody(json_encode(['jatanlin_id' => $id]))
            ->get('https://irsms.korlantas.polri.go.id/irsmsapi/api/getDetailJatanlin')->json();

        return view('case.show', compact('case'));
    }

    public function save($id)
    {
        $case = Http::withHeaders([
            'Key' => '3b1i4BNs3C7y1BTudsPeMFRtkLBGiennZ0Tojg3dL4Ynql3ehRsfZbsQubzRR5mmK99xEVPyQE26KTpo5h6DxwW34m2TkUGnqD24=getDetailJatanlin',
            'Content-Type' => 'application/json',
        ])
            ->withBody(json_encode(['jatanlin_id' => $id]))
            ->get('https://irsms.korlantas.polri.go.id/irsmsapi/api/getDetailJatanlin')->json();

        if(isset($case['result'][0])){
            $currentCase = Accident::where('id', $case['result'][0]['id'])->first();

            if($currentCase){
                return redirect()->route('view_produktivitas_accident', ['accident_id' => $case['result'][0]['id']]);
            }

            DB::beginTransaction();
            try{
                Accident::create([
                    'id' => $case['result'][0]['id'],
                    'dors_id' => $case['result'][0]['dors_id'],

                    'no_lp' => $case['result'][0]['no_lp'],

                    'accident_date' =>  $case['result'][0]['accident_date'],
                    'accident_time' =>  $case['result'][0]['accident_time'],
                    'latitude' =>  $case['result'][0]['latitude'],
                    'longtitude' =>  $case['result'][0]['longitude'],
                    'md' =>  0,
                    'lb' =>  0,
                    'lr' =>  0,
                    'road_name' => $case['result'][0]['road_name'],
                    'report_date' =>  $case['result'][0]['report_date'],
                    'report_time' => $case['result'][0]['report_time'],
                    'damage_lose_desc' =>  $case['result'][0]['damage_lose_desc'],
                    'polda_id' =>  $case['result'][0]['polda_id'], 
                    'polda_name' =>  $case['result'][0]['polda_name'],
                    'polres_id' =>  $case['result'][0]['polres_id'],
                    'polres_name' =>  $case['result'][0]['polres_name'],
                    'police_id' =>  $case['result'][0]['polres_id'] ?? $case['result'][0]['polda_id'],

                    'officer_id' => $case['result'][0]['officer_id'],
                    'rank_id' => $case['result'][0]['rank_id'],
                    'officer_first_name' => '', //
                    'officer_last_name' => '', //
               
                    'temporary_deductive' => $case['result'][0]['temporary_deductive'],
                    'accident_description' => $case['result'][0]['accident_description'],
    
                    'total_ranmor'=> 1,
                
                    'state' => $case['result'][0]['state'],
                    'selra_flag' =>'S0107',
                    'case_flag' => 'JATANLIN',
                ]);

                CaseVehicle::create([
                    'accident_id' => $case['result'][0]['id'],

                    'stnk_number' => $case['result'][0]['stnk_no'],
                    'stnk_province' => $case['result'][0]['propinsi_stnk'],
                    'stnk_regency' => $case['result'][0]['kabupaten_stnk'],
                    'stnk_district' => $case['result'][0]['kecamatan_stnk'],
                    'stnk_village' => $case['result'][0]['kelurahan_stnk'],
                    'stnk_road_name' => $case['result'][0]['road_name_stnk'],
                    'stnk_rt' => $case['result'][0]['rt_stnk'],
                    'stnk_rw' => $case['result'][0]['rw_stnk'],
                        
                    'owner_name' => $case['result'][0]['owner_name'],
                    'owner_first_name' => $case['result'][0]['first_name'],
                    'owner_last_name' => $case['result'][0]['last_name'],
                    'owner_address' => $case['result'][0]['owner_address'],
                    'owner_gender' => $case['result'][0]['gender'],
                    'owner_religion' => $case['result'][0]['religion'],
                    'owner_birth_date' => $case['result'][0]['birth_date'],
                    'owner_age' => $case['result'][0]['age'],
                    'owner_identity_type' => $case['result'][0]['identity_type'],
                    'owner_identity_number' => $case['result'][0]['identity_no'],
                    'owner_license_class' => $case['result'][0]['license_class'],
                    'owner_license_number' => $case['result'][0]['license_no'],
                        
                    'vehicle_type' => $case['result'][0]['vehicle_type'],
                    'vehicle_design' => $case['result'][0]['vehicle_design'],
                    'vehicle_color' => $case['result'][0]['vehicle_color'],
                        
                    'plate_number' => $case['result'][0]['plate_no'],
                    'frame_number' => $case['result'][0]['frame_no'],
                    'engine_number' => $case['result'][0]['engine_no'],
                    'engine_capacity' => $case['result'][0]['engine_capacity'],
                    'production_year' => $case['result'][0]['production_year'],
                    'cargo_load' => $case['result'][0]['muatan'],
                    'axis' => $case['result'][0]['sumbu'],
        
                    'temporary_deductive' => $case['result'][0]['temporary_deductive'],
                    'accident_description' => $case['result'][0]['accident_description'],
                ]);

                DB::commit();
            } catch (\Exception $e) {
                DB::rollBack();
                
                return redirect()->back()->with('error', 'Terjadi kesalahan pada saat menyimpan data.');
            }

            return redirect()->route('view_produktivitas_accident', ['accident_id' => $case['result'][0]['id']]);
        }

        return redirect()->back()->with('error', 'Terjadi kesalahan pada saat menyimpan data.');
    }

    public function resetResolution(Request $request, $id)
    {
        $resolutionId = $request->input('resolutionId');

        if($resolutionId == 'S0107') {
            Accident::where('id', $id)->update(['selra_flag' => 'S0107']);

            UploadSuratKetetapan::where('accident_id', $id)->delete();
        }

        // Redirect
        return redirect()->route('view_produktivitas_accident', ['accident_id' => $id]);
    }
}

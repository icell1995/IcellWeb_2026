                "AttachmentExtension" => "",
                "CreatedDate" => $date->format('Y-m-d'),
                "CreatedBy" => "ADMIN POLRES",
                "UpdatedDate" => null,
                "UpdatedBy" => null,
            ];

            $no++;
        }

        return collect($data);
    }
}

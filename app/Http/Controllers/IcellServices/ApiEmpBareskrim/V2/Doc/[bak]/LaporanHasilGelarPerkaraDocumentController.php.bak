                "NamaPejabatSatuanAtas" => "Komjen Pol Bambang Sutopo",
                "NRPPejabatSatuanAtas" => "990898989",
                "PangkatIdPejabatSatuanAtas" => 2,
                "JabatanPejabatSatuanAtas" => 3,
                "AtasanPejabatSatuanAtas" => 4,
                "PejabatPenandatanganDokumen" => [
                    [
                        "Nama" => "SUGADRI S.I.K", 
                        "Pangkat" => "KOMPOL",

                                    'is_unknown_gender' => (!empty($suspectDetermination['is_unknown_gender'])) ? filter_var($suspectDetermination['is_unknown_gender'], FILTER_VALIDATE_BOOLEAN) : null,
                                    'is_unknown_birth_place' => (!empty($suspectDetermination['is_unknown_birth_place'])) ? filter_var($suspectDetermination['is_unknown_birth_place'], FILTER_VALIDATE_BOOLEAN) : null,
                                    'is_unknown_birth_date' => (!empty($suspectDetermination['is_unknown_birth_date'])) ? filter_var($suspectDetermination['is_unknown_birth_date'], FILTER_VALIDATE_BOOLEAN) : null,
                                    'is_unknown_father' => (!empty($suspectDetermination['is_unknown_father'])) ? filter_var($suspectDetermination['is_unknown_father'], FILTER_VALIDATE_BOOLEAN) : null,
                                    'is_unknown_mother' => (!empty($suspectDetermination['is_unknown_mother'])) ? filter_var($suspectDetermination['is_unknown_mother'], FILTER_VALIDATE_BOOLEAN) : null,
                                    'is_unknown_nationality' => (!empty($suspectDetermination['is_unknown_nationality'])) ? filter_var($suspectDetermination['is_unknown_nationality'], FILTER_VALIDATE_BOOLEAN) : null,
                                    'is_unknown_marital_status' => (!empty($suspectDetermination['is_unknown_marital_status'])) ? filter_var($suspectDetermination['is_unknown_marital_status'], FILTER_VALIDATE_BOOLEAN) : null,
                                    'is_unknown_address' => (!empty($suspectDetermination['is_unknown_address'])) ? filter_var($suspectDetermination['is_unknown_address'], FILTER_VALIDATE_BOOLEAN) : null,
                                ],
                            ];

                            $suspect = Suspect::create(
                                $suspectData
                            );

                            $suspectIds[] = $suspect->id;
                        }else if($suspectDetermination['suspect_source_id'] == '2'){
                            $suspect = Suspect::where('id', $suspectDetermination['id'])->first();
                            
                            $suspect->update(
                                [
                                    'suspect_source_id' => $suspectDetermination['suspect_source_id'],

                                    'status' => Suspect::getEnumOption('status', 'IMPORT'),
                                    'flag' => Suspect::getEnumOption('flag', 'TERSANGKA'),
                                    'class' => Suspect::getEnumOption('class', 'DETERMINATION'),
                                    'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
                                    'insert_method' => Suspect::getEnumOption('insert_method', 'IMPORT'),

                                    'properties' => [
                                        'is_exists_phone_number' => null,
                                        'is_available_phone_number' => null,
                                        'is_exists_email' => null,
                                        'is_available_email' => null,
                                        'is_unknown_gender' => null,
                                        'is_unknown_birth_place' => null,
                                        'is_unknown_birth_date' => null,
                                        'is_unknown_father' => null,
                                        'is_unknown_mother' => null,
                                        'is_unknown_nationality' => null,
                                        'is_unknown_marital_status' => null,
                                        'is_unknown_address' => null,
                                    ],
                                ]
                            );
           
                            $suspectIds[] = $suspect->id;
                        }else if(!empty($suspectDetermination['id']) && $suspectDetermination['suspect_source_id'] == '1'){
                            $witness = Witness::where('id',$suspectDetermination['id'])->first();

                            $suspectData = [
                                'id' => Uuid::generate()->string,
                                'accident_id' => $accidentId,
                                'identity_number' => $witness->identity_number,
                                'name' => $witness->name,
                                'birth_place' => $witness->birth_place,
                                'birth_date' => $witness->birth_date,
                                'phone_number' => $witness->phone_number,
                    
                                'address' => $witness->address,
                                'identity_type_id' => $witness->identity_type_id,
                                'gender_id' => $witness->gender_id,
                                'ethnic_id' => $witness->ethnic_id,
                                'job_id' => $witness->job_id,
                                'religion_id' => $witness->religion_id,
                                'education_id' => $witness->education_id,
                                'marital_status_id' => $witness->marital_status_id,
        
                                'status' => Suspect::getEnumOption('status', 'IMPORT'),
                                'flag' => Suspect::getEnumOption('flag', 'TERSANGKA'),
                                'class' => Suspect::getEnumOption('class', 'DETERMINATION'),
                                'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
                                'insert_method' => Suspect::getEnumOption('insert_method', 'IMPORT'),
        
                                'country_id' => $witness->country_id,
                                'province_id' => $witness->province_id,
                                'regency_id' => $witness->regency_id,
                                'district_id' => $witness->district_id,
                                'village_id' => $witness->village_id,
        
                                'suspect_source_id' => $suspectDetermination['suspect_source_id'],

                                'properties' => [
                                    'is_exists_phone_number' => null,
                                    'is_available_phone_number' => null,
                                    'is_exists_email' => null,
                                    'is_available_email' => null,
                                    'is_unknown_gender' => null,
                                    'is_unknown_birth_place' => null,
                                    'is_unknown_birth_date' => null,
                                    'is_unknown_father' => null,
                                    'is_unknown_mother' => null,
                                    'is_unknown_nationality' => null,
                                    'is_unknown_marital_status' => null,
                                    'is_unknown_address' => null,
                                ],
                            ];

                            $suspect = Suspect::create(
                                $suspectData
                            );

                            $suspectIds[] = $suspect->id;
                        }
                    }else{
                        $suspectData = [
                            'accident_id' => $accidentId,
                            'identity_number' => ($suspectDetermination['identity_number'] === "null" || $suspectDetermination['identity_number'] === "undefined") ? null : $suspectDetermination['identity_number'],
                            'name' => ($suspectDetermination['name'] === "null" || $suspectDetermination['name'] === "undefined") ? null : $suspectDetermination['name'],
                            'birth_place' => ($suspectDetermination['birth_place'] === "null" || $suspectDetermination['birth_place'] === "undefined") ? null : $suspectDetermination['birth_place'],
                            'birth_date' => ($suspectDetermination['birth_date'] === "null" || $suspectDetermination['birth_date'] === "undefined") ? null : $suspectDetermination['birth_date'],
                            'father_name' => ($suspectDetermination['father_name'] === "null" || $suspectDetermination['father_name'] === "undefined") ? null : $suspectDetermination['father_name'],
                            'mother_name' => ($suspectDetermination['mother_name'] === "null" || $suspectDetermination['mother_name'] === "undefined") ? null : $suspectDetermination['mother_name'],
                            'nationality' => ($suspectDetermination['nationality'] === "null" || $suspectDetermination['nationality'] === "undefined") ? null : $suspectDetermination['nationality'],
                            'phone_number' => ($suspectDetermination['phone_number'] === "null" || $suspectDetermination['phone_number'] === "undefined") ? null : $suspectDetermination['phone_number'],
                            'email_address' => ($suspectDetermination['email'] === "null" || $suspectDetermination['email'] === "undefined") ? null : $suspectDetermination['email'],
                            'address' => ($suspectDetermination['address'] === "null" || $suspectDetermination['address'] === "undefined") ? null : $suspectDetermination['address'],
                            'identity_type_id' => ($suspectDetermination['identity_type_id'] === "null" || $suspectDetermination['identity_type_id'] === "undefined") ? null : $suspectDetermination['identity_type_id'],
                            'gender_id' => ($suspectDetermination['gender_id'] === "null" || $suspectDetermination['gender_id'] === "undefined") ? null : $suspectDetermination['gender_id'],
                            'ethnic_id' => ($suspectDetermination['ethnic_id'] === "null" || $suspectDetermination['ethnic_id'] === "undefined") ? null : $suspectDetermination['ethnic_id'],
                            'job_id' => ($suspectDetermination['job_id'] === "null" || $suspectDetermination['job_id'] === "undefined") ? null : $suspectDetermination['job_id'],
                            'religion_id' => ($suspectDetermination['religion_id'] === "null" || $suspectDetermination['religion_id'] === "undefined") ? null : $suspectDetermination['religion_id'],
                            'education_id' => ($suspectDetermination['education_id'] === "null" || $suspectDetermination['education_id'] === "undefined") ? null : $suspectDetermination['education_id'],
                            'marital_status_id' => ($suspectDetermination['marital_status_id'] === "null" || $suspectDetermination['marital_status_id'] === "undefined") ? null : $suspectDetermination['marital_status_id'],
    
                            'status' => ($suspectDetermination['identity_status'] === "null" || $suspectDetermination['identity_status'] === "undefined") ? null : $suspectDetermination['identity_status'],
                            'flag' => Suspect::getEnumOption('flag', 'TERSANGKA'),
                            'class' => Suspect::getEnumOption('class', 'DETERMINATION'),
                            'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
    
                            'country_id' => ($suspectDetermination['country_id'] === "null" || $suspectDetermination['country_id'] === "undefined") ? null : $suspectDetermination['country_id'],
                            'province_id' => ($suspectDetermination['province_id'] === "null" || $suspectDetermination['province_id'] === "undefined") ? null : $suspectDetermination['province_id'],
                            'regency_id' => ($suspectDetermination['regency_id'] === "null" || $suspectDetermination['regency_id'] === "undefined") ? null : $suspectDetermination['regency_id'],
                            'district_id' => ($suspectDetermination['district_id'] === "null" || $suspectDetermination['district_id'] === "undefined") ? null : $suspectDetermination['district_id'],
                            'village_id' => ($suspectDetermination['village_id'] === "null" || $suspectDetermination['village_id'] === "undefined") ? null : $suspectDetermination['village_id'],
    
                            'suspect_source_id' => ($suspectDetermination['suspect_source_id'] === "null" || $suspectDetermination['suspect_source_id'] === "undefined") ? null : $suspectDetermination['suspect_source_id'],

                            'properties' => [
                                'is_exists_phone_number' => ($suspectDetermination['is_exists_phone_number'] === "null" || $suspectDetermination['is_exists_phone_number'] === "undefined") ? null : ((!empty($suspectDetermination['is_exists_phone_number'])) ? filter_var($suspectDetermination['is_exists_phone_number'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_available_phone_number' => ($suspectDetermination['is_available_phone_number'] === "null" || $suspectDetermination['is_available_phone_number'] === "undefined") ? null : ((!empty($suspectDetermination['is_available_phone_number'])) ? filter_var($suspectDetermination['is_available_phone_number'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_exists_email' => ($suspectDetermination['is_exists_email'] === "null" || $suspectDetermination['is_exists_email'] === "undefined") ? null : ((!empty($suspectDetermination['is_exists_email'])) ? filter_var($suspectDetermination['is_exists_email'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_available_email' => ($suspectDetermination['is_available_email'] === "null" || $suspectDetermination['is_available_email'] === "undefined") ? null : ((!empty($suspectDetermination['is_available_email'])) ? filter_var($suspectDetermination['is_available_email'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_gender' => ($suspectDetermination['is_unknown_gender'] === "null" || $suspectDetermination['is_unknown_gender'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_gender'])) ? filter_var($suspectDetermination['is_unknown_gender'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_birth_place' => ($suspectDetermination['is_unknown_birth_place'] === "null" || $suspectDetermination['is_unknown_birth_place'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_birth_place'])) ? filter_var($suspectDetermination['is_unknown_birth_place'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_birth_date' => ($suspectDetermination['is_unknown_birth_date'] === "null" || $suspectDetermination['is_unknown_birth_date'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_birth_date'])) ? filter_var($suspectDetermination['is_unknown_birth_date'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_father' => ($suspectDetermination['is_unknown_father'] === "null" || $suspectDetermination['is_unknown_father'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_father'])) ? filter_var($suspectDetermination['is_unknown_father'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_mother' => ($suspectDetermination['is_unknown_mother'] === "null" || $suspectDetermination['is_unknown_mother'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_mother'])) ? filter_var($suspectDetermination['is_unknown_mother'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_nationality' => ($suspectDetermination['is_unknown_nationality'] === "null" || $suspectDetermination['is_unknown_nationality'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_nationality'])) ? filter_var($suspectDetermination['is_unknown_nationality'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_marital_status' => ($suspectDetermination['is_unknown_marital_status'] === "null" || $suspectDetermination['is_unknown_marital_status'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_marital_status'])) ? filter_var($suspectDetermination['is_unknown_marital_status'], FILTER_VALIDATE_BOOLEAN) : null),
                                'is_unknown_address' => ($suspectDetermination['is_unknown_address'] === "null" || $suspectDetermination['is_unknown_address'] === "undefined") ? null : ((!empty($suspectDetermination['is_unknown_address'])) ? filter_var($suspectDetermination['is_unknown_address'], FILTER_VALIDATE_BOOLEAN) : null),
                            ],
                        ];

                        $suspect = Suspect::where('id', $suspectDetermination['id'])->first();
                        
                        $suspect->update(
                            $suspectData
                        );

                        $suspectIds[] = $suspect->id;
                    }
                }
            }

            // SUSPECT ARREST
            if($caseDegreeTypeId == "4"){
                $arrestSuspectIds = $request->arrestSuspects ?? [];

                foreach($arrestSuspectIds as $arrestSuspectId){
                    $suspect = Suspect::where('id', $arrestSuspectId)->first();
                    
                    $suspect->update([
                        'class' => Suspect::getEnumOption('class', 'ARREST'),
                        'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
                    ]);

                    $suspectIds[] = $suspect->id;
                }
            }

            // SUSPECT REVOCATION
            if($caseDegreeTypeId == "16"){
                $revocationSuspectIds = $request->revocationSuspects ?? [];

                foreach($revocationSuspectIds as $revocationSuspectId){
                    $suspect = Suspect::where('id', $revocationSuspectId)->first();
                    
                    $suspect->update([
                        'class' => Suspect::getEnumOption('class', 'REVOCATION'),
                        'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
                    ]);

                    $suspectIds[] = $suspect->id;
                }
            }

            //Attach Suspect
            $laporanHasilGelarPerkaraDocument->suspects()->detach();
            foreach ($suspectIds as $suspectId) {
                $laporanHasilGelarPerkaraDocument->suspects()->attach($suspectId);
            }
            
            DB::commit();
        } catch (\Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Terjadi kesalahan saat menyimpan data');
        }
 
        // Redirect with param accident_id
        return redirect()->route('view_produktivitas_accident', ['accident_id' => $accidentId]);
    }

    public function delete($id)
    {
        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));
        $laporanHasilGelarPerkaraDocumentId = $id;

        DB::beginTransaction();
        try{
            // Delete from database
            $laporanHasilGelarPerkaraDocument = LaporanHasilGelarPerkaraDocument::where('id', $laporanHasilGelarPerkaraDocumentId)->first();
            $laporanHasilGelarPerkaraDocument->delete();

            DB::Commit();
        } catch (\Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Terjadi kesalahan pada saat menghapus data.');
        }

        // Redirect with param accident_id
        return redirect()->route('view_produktivitas_accident', ['accident_id' => $accidentId]);
    }

    public function download($id)
    {
        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));
        $laporanHasilGelarPerkaraDocumentId = $id;
        
        $laporanHasilGelarPerkaraDocument = LaporanHasilGelarPerkaraDocument::with(['laporanHasilGelarPerkaraDocumentOfficers', 'suratPerintahPenyidikanDocument', 'timezone'])->where('id', $laporanHasilGelarPerkaraDocumentId)->first();
        $signatory = $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentOfficers->where('class','=', LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'SIGNATORY'))->first();

        $accident = Accident::with(['polres', 'polres.polda'])->where('id', $accidentId)->first();

        $signatoryHeadText = [
            'KAPOLRES' => 'KEPALA KEPOLISIAN RESOR ' . $accident->polres->full_name,
            'NO_KAPOLRES' => 'a.n. KEPALA KEPOLISIAN RESOR ' . $accident->polres->full_name . '</w:t><w:p/><w:t>' . $signatory->position->name ?? '',
            'NO_DIRLANTAS' => 'a.n. DIREKTUR LALU LINTAS POLDA ' . $accident->polres->polda->full_name . '</w:t><w:p/><w:t>' . $signatory->position->name ?? '',
        ];

        $templateProcessor = new \PhpOffice\PhpWord\TemplateProcessor('word-template/laporan_hasil_gelar_perkara.docx');

        if(isset($signatory->position)){
            if($signatory->position->position_cluster_id == '1'){
                $templateProcessor->setValue('signatoryHeadText', $signatoryHeadText['KAPOLRES']);
            }else if($signatory->position->position_cluster_id == '9'){
                $templateProcessor->setValue('signatoryHeadText', $signatoryHeadText['NO_DIRLANTAS']);
            }else{
                $templateProcessor->setValue('signatoryHeadText', $signatoryHeadText['NO_KAPOLRES']);
            }
        }

        $documentDate = Carbon::parse($laporanHasilGelarPerkaraDocument->document_date)->locale('id')->translatedFormat('d F Y');
        $accidentNumber = $accident->no_lp;
        $suratPerintahPenyidikanDocumentNumber = $laporanHasilGelarPerkaraDocument->suratPerintahPenyidikanDocument->document_number;
        $caseDegreeInviteReference = $laporanHasilGelarPerkaraDocument->case_degree_invite_reference;
        $dayDate = Carbon::parse($laporanHasilGelarPerkaraDocument->date)->locale('id')->translatedFormat('l') . ', ' . Carbon::parse($laporanHasilGelarPerkaraDocument->date)->locale('id')->translatedFormat('d F Y');
        $time = $laporanHasilGelarPerkaraDocument->time . ' ' . $laporanHasilGelarPerkaraDocument->timezone->name;
        $place = $laporanHasilGelarPerkaraDocument->place;
        $caseDegreeLeader = $laporanHasilGelarPerkaraDocument->case_degree_leader;
        $attendees = $laporanHasilGelarPerkaraDocument->attendees;
        $discussion = $laporanHasilGelarPerkaraDocument->discussion;
        $conclusion = $laporanHasilGelarPerkaraDocument->conclusion;
        $closing = $laporanHasilGelarPerkaraDocument->closing;

        $police = $accident->polres;
        $policeAddress = $police->address . ', ' . $police->polres_zipcode;
        $policeFullName = (in_array($police->id, ['1114'])) ? $police->full_name : 'SAT LANTAS ' . $police->full_name;
        $policeProvinceName = $police->polres_province;

        $signatoryName = PeopleNameHelper::getFullName($signatory->first_title, $signatory->first_name, $signatory->last_name, $signatory->last_title);
        $signatoryRankName = $signatory->rank->name ?? '';
        $signatoryRegisterNumber = $signatory->register_number;

        $templateProcessor->setValue('documentLocation', $policeProvinceName);
        $templateProcessor->setValue('documentDate', $documentDate);
        $templateProcessor->setValue('accidentNumber', $accidentNumber);
        $templateProcessor->setValue('suratPerintahPenyidikanDocumentNumber', $suratPerintahPenyidikanDocumentNumber);
        $templateProcessor->setValue('caseDegreeInviteReference', $caseDegreeInviteReference);
        $templateProcessor->setValue('dayDate', $dayDate);
        $templateProcessor->setValue('time', $time);
        $templateProcessor->setValue('place', $place);
        $templateProcessor->setValue('caseDegreeLeader', $caseDegreeLeader);
        $templateProcessor->setValue('attendees', $attendees);
        $templateProcessor->setValue('discussion', $discussion);
        $templateProcessor->setValue('conclusion', $conclusion);
        $templateProcessor->setValue('closing', $closing);
        $templateProcessor->setValue('policeAddress', $policeAddress);
        $templateProcessor->setValue('policeFullName', strtoupper($policeFullName));
        $templateProcessor->setValue('signatoryName', $signatoryName);
        $templateProcessor->setValue('signatoryRankName', strtoupper($signatoryRankName));
        $templateProcessor->setValue('signatoryRegisterNumber', $signatoryRegisterNumber);

        $filename = 'generate/' . Str::uuid() . ' - Laporan Hasil Gelar Perkara - Resor ' . $accident->polres->full_name;
        $templateProcessor->saveAs($filename.'.docx');
        return response()->download($filename.'.docx')->deleteFileAfterSend(true);
    }

    // =====( API )=====
    public function getWitnesses(){
        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));

        $witnesses = Witness::with(['identityType'])->where('accident_id', $accidentId)->get();

        return response()->json([
            'status' => 'success',
            'code' => 200,
            'data' => $witnesses
        ], 200);
    }
   
    public function getLocations(Request $request){
        $class = $request->class;
        $parent_id = $request->parent_id;

        $locations = Location::where('is_active', true)
                        ->where('parent_id', $parent_id)
                        ->where('class', $class)
                        ->get();

        return response()->json([
            'status' => 'success',
            'code' => 200,
            'data' => $locations
        ], 200);
    }

    public function getSuspects(Request $request){
        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));

        $class = $request->class;
        $flag = $request->flag;
        $group = $request->group;

        $suspects = Suspect::with(['identityType'])->where('accident_id', $accidentId)->get();

        if($class){
            $suspects = $suspects->where('class', $class);
        }

        if($flag){
            $suspects = $suspects->where('flag', $flag);
        }

        if($group){
            $suspects = $suspects->where('group', $group);
        }

        return response()->json([
            'status' => 'success',
            'code' => 200,
            'data' => $suspects
        ], 200);
    }

    public function getCaseDegreeTypes()
    {
        $caseDegreeTypes = CaseDegreeType::where('is_active', true)->orderBy('sort')->get();

        return response()->json([
            'status' => 'success',
            'code' => 200,
            'data' => $caseDegreeTypes
        ], 200);
    }

    public function validateRequestForm(Request $request)
    {
        try{
            $validator = $this->validateForm($request);

            if ($validator->fails()) {
                return response()->json([
                    'success' => false,
                    'code' => 422,
                    'errors' => $validator->errors()
                ], 422);
            }

            return response()->json([
                'success' => true,
                'code' => 200,
                'message' => 'Silahkan menunggu proses simpan data',
            ], 200);
        }catch(\Exception $e){
            return response()->json([
                'success' => false, 
                'errors' => 'Terjadi kesalahan pada sistem.',
                'code' => 500,
            ], 500);
        }
    }

    private function validateForm(Request $request)
    {
        return Validator::make($request->all(), [
            'suratPerintahPenyidikanDocument' => 'required',
            'documentDate' => 'required',
            'documentType' => 'required',
            'caseDegreeType' => 'required',

            'caseDegreeInviteReference' => 'required | max:255',
            'caseDegreeInviteDate' => 'required',

            'date' => 'required',
            'time' => 'required',
            'timezone' => 'required',
            'place' => 'required | max:255',
            'caseDegreeLeader' => 'required | max:255',
            'attendees' => 'required | numeric | max:999 | min:1',

            'discussion' => 'required | max:65535',
            'conclusion' => 'required | max:65535',
            'closing' => 'required | max:65535',

            'signatory' => 'required_unless:isUpperUnitDocument,true',

            'upperUnitOfficerName' => 'required_if:isUpperUnitDocument,true|max:255',
            'upperUnitOfficerRegisterNumber' => 'required_if:isUpperUnitDocument,true|max:8',
            'upperUnitOfficerRank' => 'required_if:isUpperUnitDocument,true',
            'upperUnitOfficerPosition' => 'required_if:isUpperUnitDocument,true|max:255',
            'upperUnitSuperiorOfficerName' => [
                Rule::requiredIf(function () use ($request) {
                    return $request->isUpperUnitDocument == 'true' && $request->isOnBehalfOfSuperiorOfficer == 'true';
                }),
                'max:255'
            ],

            'photos' => 'array',
            'photos.*' => 'mimes:jpg,jpeg,png | max:8192',

            'suspectDeterminationIds'=> [
                Rule::requiredIf(function () use ($request) {
                    return $request->caseDegreeType == '1';
                })
            ],

            'arrestSuspects' => [
                Rule::requiredIf(function () use ($request) {
                    return $request->caseDegreeType == '4';
                })
            ],

            'revocationSuspects' => [
                Rule::requiredIf(function () use ($request) {
                    return $request->caseDegreeType == '16';
                })
            ],
        ], [
            'suratPerintahPenyidikanDocument.required' => 'No Surat Perintah Penyidikan harus diisi',
            'type.required' => 'Jenis LHGP harus diisi',
            'caseDegreeType.required' => 'Jenis Gelar Perkara harus diisi',

            'caseDegreeInviteReference.required' => 'No Surat Undangan Gelar Perkara harus diisi',
            'caseDegreeInviteReference.max' => 'No Surat Undangan Gelar Perkara maksimal 255 karakter',
            'caseDegreeInviteDate.required' => 'Tanggal Surat Undangan Gelar Perkara harus diisi',

            'date.required' => 'Tanggal Pelaksanaan harus diisi',
            'time.required' => 'Waktu Pelaksanaan harus diisi',
            'timezone.required' => 'Zona Waktu Pelaksanaan harus diisi',
            'place.required' => 'Tempat Pelaksanaan harus diisi',
            'place.max' => 'Tempat Pelaksanaan maksimal 255 karakter',
            'caseDegreeLeader.required' => 'Pimpinan Gelar Perkara harus diisi',
            'caseDegreeLeader.max' => 'Pimpinan Gelar Perkara maksimal 255 karakter',
            'attendees.required' => 'Jumlah Peserta harus diisi',
            'attendees.numeric' => 'Jumlah Peserta harus berupa angka',
            'attendees.min' => 'Jumlah Peserta minimal 1',
            'attendees.max' => 'Jumlah Peserta maksimal 999',

            'discussion.required' => 'Pembahasan harus diisi',
            'discussion.max' => 'Pembahasan maksimal 65535 karakter',
            'conclusion.required' => 'Kesimpulan harus diisi',
            'conclusion.max' => 'Kesimpulan maksimal 65535 karakter',
            'closing.required' => 'Penutup harus diisi',
            'closing.max' => 'Penutup maksimal 65535 karakter',
            
            'documentDate.required' => 'Tanggal Dokumen LHGP harus diisi',
            'signatory.required_unless' => 'Yang Menandatangani harus diisi',

            'upperUnitOfficerName.required_if' => 'Nama Pejabat satuan atas harus diisi',
            'upperUnitOfficerName.max' => 'Nama Pejabat satuan atas maksimal 255 karakter',
            'upperUnitOfficerRegisterNumber.required_if' => 'NRP Pejabat satuan atas harus diisi',
            'upperUnitOfficerRegisterNumber.max' => 'NRP Pejabat satuan atas harus maksimal 8 digit',
            'upperUnitOfficerRank.required_if' => 'Pangkat Pejabat satuan atas harus diisi',
            'upperUnitOfficerPosition.required_if' => 'Jabatan Pejabat satuan atas harus diisi',
            'upperUnitOfficerPosition.max' => 'Jabatan Pejabat satuan atas maksimal 255 karakter',
            'upperUnitSuperiorOfficerName.required' => 'Atasan Pejabat satuan atas harus diisi',
            'upperUnitSuperiorOfficerName.max' => 'Atasan Pejabat satuan atas maksimal 255 karakter',

            'photos.*.mimes' => 'Foto harus berupa file JPG, JPEG, atau PNG',
            'photos.*.max' => 'Foto maksimal 8MB',

            'suspectDeterminationIds.required' => 'Tersangka Penetapan Tersangka Harus Diisi',
            'arrestSuspects.required' => 'Tersangka Penahanan Tersangka Harus Diisi',
            'revocationSuspects.required' => 'Tersangka Pencabutan Status Tersangka Harus Diisi',
        ]);
    }
}

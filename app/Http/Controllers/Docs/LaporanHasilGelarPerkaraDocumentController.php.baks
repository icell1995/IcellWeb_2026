<?php

namespace App\Http\Controllers\Docs;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Validator;
use Illuminate\Validation\Rule;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Collection;
use Webpatser\Uuid\Uuid;
use Illuminate\Support\Str;
use Carbon\Carbon;
use App\Helpers\PeopleNameHelper;

use App\Services\Doc\DocService;

use App\Models\Doc\SuratPerintahPenyidikanDocument\SuratPerintahPenyidikanDocument;
use App\Models\Doc\LaporanHasilGelarPerkaraDocument\LaporanHasilGelarPerkaraDocument;
use App\Models\Doc\LaporanHasilGelarPerkaraDocument\LaporanHasilGelarPerkaraDocumentFile;
use App\Models\Doc\LaporanHasilGelarPerkaraDocument\LaporanHasilGelarPerkaraDocumentOfficer;

use App\Models\Officer;
use App\Models\Accident;
use App\Models\LaporanHasilGelarPerkara;
use App\Models\Lib\Rank;
use App\Models\Lib\Position;
use App\Models\Polda;
use App\Models\Polres;
use App\Models\Lib\CaseDegreeType;
use App\Models\Lib\Timezone;
use App\Models\Lib\SuspectSource;
use App\Models\Lib\IdentityType;
use App\Models\Lib\Gender;
use App\Models\Lib\Ethnic;
use App\Models\Lib\Job;
use App\Models\Lib\Religion;
use App\Models\Lib\Education;
use App\Models\Lib\MaritalStatus;
use App\Models\Lib\Location;
use App\Models\Lib\Police;
use App\Models\Suspect;
use App\Models\Witness;

class LaporanHasilGelarPerkaraDocumentController extends Controller
{
    protected $docService;

    public function __construct(DocService $docService)
    {
        $this->docService = $docService;
    }
 
    public function create()
    {
        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));
        $accident = Accident::where('id', $accidentId)->first();
        $police = Police::with('parent')->where('id', $accident->polres_id)->first();

        $suratPerintahPenyidikanDocuments = SuratPerintahPenyidikanDocument::where('accident_id', $accidentId)
            ->whereIn('status_id', $this->docService->requiredDocumentStatusIds)
            ->get();

        $authorizedSignatories = Officer::withRelated()
            ->selectFullName()
            ->where('police_id', $accident->polres_id)
            ->whereHasUserActive()
            ->hasDataComplete()
            ->signatory()
            ->active()
            ->valid()
            ->orderBy('first_name')
            ->get();

        $ranks = Rank::where('is_active', true)
                        ->wherePolri()
                        ->orderBy('sort')
                        ->get();
       
        $positions = Position::whereIn('police_id', [$police->id, $police->parent->id ?? null, $police->parent->parent->id ?? null])
                        ->where('is_active', true)
                        ->orderBy('sort')
                        ->get();

        $timezones = Timezone::where('is_active', true)
                                ->orderBy('sort')
                                ->get();

        $suspectSources = SuspectSource::where('group', 'LAPORAN_HASIL_GELAR_PERKARA')
                                            ->where('is_active', true)
                                            ->orderBy('sort')
                                            ->get();

        $identityTypes = IdentityType::where('is_active', true)
                                        ->orderBy('sort')
                                        ->get();

        $genders = Gender::where('is_active', true)
                            ->orderBy('sort')
                            ->get();
        
        $ethnics = Ethnic::where('is_active', true)
                            ->orderBy('sort')
                            ->get();
        
        $jobs = Job::where('is_active', true)
                        ->orderBy('sort')
                        ->get();

        $religions = Religion::where('is_active', true)
                                ->orderBy('sort')
                                ->get();

        $educations = Education::where('is_active', true)
                                ->orderBy('sort')
                                ->get();

        $maritalStatuses = MaritalStatus::where('is_active', true)
                                        ->orderBy('sort')
                                        ->get();
        
        $countries = Location::where('is_active', true)
                                ->where('class', 'COUNTRY')
                                ->orderBy('sort')
                                ->get();

        $suspects = Suspect::with([
                                    'identityType', 
                                    'gender', 
                                    'ethnic', 
                                    'education', 
                                    'job', 
                                    'religion', 
                                    'maritalStatus', 
                                    'location', 
                                    'country', 
                                    'province', 
                                    'regency', 
                                    'district', 
                                    'village'
                                ])
                                ->where('accident_id', $accidentId)->get();

        $witnesses = Witness::where('accident_id', $accidentId)->get();

        $viewData =[
            'accidentId' => $accidentId,
            'accident' => $accident,
            'suratPerintahPenyidikanDocuments' => $suratPerintahPenyidikanDocuments,
            'authorizedSignatories' => $authorizedSignatories,
            'ranks' => $ranks,
            'positions' => $positions,
            'timezones' => $timezones,
            'suspectSources' => $suspectSources,
            'identityTypes' => $identityTypes,
            'genders' => $genders,
            'ethnics' => $ethnics,
            'jobs' => $jobs,
            'religions' => $religions,
            'educations' => $educations,
            'maritalStatuses' => $maritalStatuses,
            'countries' => $countries,
            'suspects' => $suspects,
            'arrerstedSuspects' => $suspects->where('flag', Suspect::getEnumOption('flag', 'TERSANGKA')),
            'revocationSuspects' => $suspects->where('flag', Suspect::getEnumOption('flag', 'TERSANGKA')),
            'witnesses' => $witnesses
        ];

        return view('docs.laporan-hasil-gelar-perkara-document.create', $viewData);
    }

    public function store(Request $request)
    {
        // Validation
        $validator = $this->validateForm($request);
    
        if ($validator->fails()) {
            return redirect()->back()->withErrors($validator)->withInput();
        }

        // Get URL Parameter
        $accidentId = htmlspecialchars($request->accident_id);

        // Define & Sanitize Text Input
        $user = Auth::user();
        $suratPerintahPenyidikanDocumentId = htmlspecialchars($request->suratPerintahPenyidikanDocument);
        $documentType = htmlspecialchars($request->documentType);
        $caseDegreeTypeId = htmlspecialchars($request->caseDegreeType);
        $caseDegreeInviteReference = htmlspecialchars($request->caseDegreeInviteReference);
        $caseDegreeInviteDate = htmlspecialchars($request->caseDegreeInviteDate);

        $date = htmlspecialchars($request->date);
        $time = htmlspecialchars($request->time);
        $timezoneId = htmlspecialchars($request->timezone);
        $place = htmlspecialchars($request->place);
        $caseDegreeLeader = htmlspecialchars($request->caseDegreeLeader);
        $attendees = htmlspecialchars($request->attendees);

        $discussion = htmlspecialchars($request->discussion);
        $conclusion = htmlspecialchars($request->conclusion);
        $closing = htmlspecialchars($request->closing);

        $documentDate = htmlspecialchars($request->documentDate);
        $signatoryId = htmlspecialchars($request->signatory);
        $isUpperUnitDocument = htmlspecialchars($request->isUpperUnitDocument);
        $upperUnitOfficerName = htmlspecialchars($request->upperUnitOfficerName);
        $upperUnitOfficerRegisterNumber = htmlspecialchars($request->upperUnitOfficerRegisterNumber);
        $upperUnitOfficerRank = htmlspecialchars($request->upperUnitOfficerRank);
        $upperUnitOfficerPosition = htmlspecialchars($request->upperUnitOfficerPosition);
        $isOnBehalfOfSuperiorOfficer = htmlspecialchars($request->isOnBehalfOfSuperiorOfficer);
        $upperUnitSuperiorOfficerName = htmlspecialchars($request->upperUnitSuperiorOfficerName);

        $photos = $request->file('photos');

        $isLegacy = filter_var($request->isLegacy, FILTER_VALIDATE_BOOLEAN);

        DB::beginTransaction();
        try{
            $laporanHasilGelarPerkaraDocument = LaporanHasilGelarPerkaraDocument::create([
                'accident_id' => $accidentId,
                'surat_perintah_penyidikan_document_id' => $suratPerintahPenyidikanDocumentId,
                'document_date' => $documentDate,
                'document_type' => $documentType,
                'case_degree_type_id' => $caseDegreeTypeId,

                'case_degree_invite_reference' => $caseDegreeInviteReference,
                'case_degree_invite_date' => $caseDegreeInviteDate,

                'date'=> $date,
                'time' => $time,
                'timezone_id' => $timezoneId,
                'place' => $place,
                'case_degree_leader' => $caseDegreeLeader,
                'attendees' => $attendees,

                'discussion' => $discussion,
                'conclusion' => $conclusion,
                'closing' => $closing,

                'is_legacy' => $isLegacy,
            ]);

            $laporanHasilGelarPerkaraDocumentId = $laporanHasilGelarPerkaraDocument->id;

            // Image Upload
            if($photos){
                foreach($photos as $photo){
                    $photoOriginalName = $photo->getClientOriginalName();
                    $photoHashName = $photo->hashName();
                    $photoExtension = $photo->getClientOriginalExtension();
                    $photoMimeType = $photo->getMimeType();
                    $photoSize = $photo->getSize();

                    $path = public_path('documents/laporan-hasil-gelar-perkara-document/images/');

                    $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentFiles()->create([
                        'laporan_hasil_gelar_perkara_document_id' => $laporanHasilGelarPerkaraDocumentId,
                        'name' => $photoHashName,
                        'original_name' => $photoOriginalName,
                        'extension' => $photoExtension,
                        'mimetype' => $photoMimeType,
                        'size' => $photoSize,
                        'type' => LaporanHasilGelarPerkaraDocumentFile::getEnumOption('type', 'IMAGE'),
                    ]);

                    $photo->move($path, $photoHashName);
                }
            }

            //SIGNATORY
            $signatoryCreateData = [];
            if($isUpperUnitDocument == 'true'){
                $rank = Rank::where('id', $upperUnitOfficerRank)->first();
                $isOnBehalf = ($isOnBehalfOfSuperiorOfficer == 'true') ? true : false;

                $signatoryCreateData = [
                    'laporan_hasil_gelar_perkara_document_id' => $laporanHasilGelarPerkaraDocumentId,
                    'register_number' => $upperUnitOfficerRegisterNumber,

                    'first_title' => null,
                    'first_name' => $upperUnitOfficerName,
                    'last_name' => null,
                    'last_title' => null,

                    'rank_id' => $rank->id,
                    'position_id' => $upperUnitOfficerPosition,
                    'is_on_behalf' => $isOnBehalf,
                    'on_behalf_name' => $upperUnitSuperiorOfficerName,

                    'police_id' => null,
                    'status' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('status', 'UPPER_UNIT_LEVEL'),
                    'flag' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('flag', 'UPPER_UNIT_LEVEL'),
                    'class' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'SIGNATORY'),
                    'insert_method' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'MANUAL'),
                ];
            }else{
                $signatory = Officer::where('id',$signatoryId)->first();

                $signatoryCreateData = [
                    'laporan_hasil_gelar_perkara_document_id' => $laporanHasilGelarPerkaraDocumentId,
                    'register_number' => $signatory->register_number,
                    
                    'first_title' => $signatory->first_title,
                    'first_name' => $signatory->first_name,
                    'last_name' => $signatory->last_name,
                    'last_title' => $signatory->last_title,

                    'rank_id' => $signatory->rank_id,
                    'position_id' => $signatory->position_id,
                    'phone_number' => $signatory->phone_number,
                    'email' => $signatory->email,

                    'police_id' => $signatory->police_id,
                    'status' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('status', 'PRESENT'),
                    'flag' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('flag', 'INTERNAL'),
                    'class' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'SIGNATORY'),
                    'insert_method' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'IMPORT'),
                ];
            }
            $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentOfficers()->create($signatoryCreateData);

            $suspectIds = [];

            // SUSPECT DETERMINATION
            if($caseDegreeTypeId == "1"){
                $suspectDeterminationSuspectSourceId = $request->suspectDeterminationSuspectSourceId ?? [];
                $suspectDeterminationIds = $request->suspectDeterminationIds ?? [];
                $suspectDeterminationIdentityStatus = $request->suspectDeterminationIdentityStatus ?? [];
                $suspectDeterminationIdentityTypeId = $request->suspectDeterminationIdentityTypeId ?? [];
                $suspectDeterminationIdentityNumber = $request->suspectDeterminationIdentityNumber ?? [];
                $suspectDeterminationName = $request->suspectDeterminationName ?? [];
                $suspectDeterminationGenderId = $request->suspectDeterminationGenderId ?? [];
                $suspectDeterminationBirthPlace = $request->suspectDeterminationBirthPlace ?? [];
                $suspectDeterminationBirthDate = $request->suspectDeterminationBirthDate ?? [];
                $suspectDeterminationFatherName = $request->suspectDeterminationFatherName ?? [];
                $suspectDeterminationMotherName = $request->suspectDeterminationMotherName ?? [];
                $suspectDeterminationNationality = $request->suspectDeterminationNationality ?? [];
                $suspectDeterminationEthnicId = $request->suspectDeterminationEthnicId ?? [];
                $suspectDeterminationJobId = $request->suspectDeterminationJobId ?? [];
                $suspectDeterminationReligionId = $request->suspectDeterminationReligionId ?? [];
                $suspectDeterminationEducationId = $request->suspectDeterminationEducationId ?? [];
                $suspectDeterminationMaritalStatusId = $request->suspectDeterminationMaritalStatusId ?? [];
                $suspectDeterminationPhoneNumber = $request->suspectDeterminationPhoneNumber ?? [];
                $suspectDeterminationIsExistsPhoneNumber = $request->suspectDeterminationIsExistsPhoneNumber ?? [];
                $suspectDeterminationIsAvailablePhoneNumber = $request->suspectDeterminationIsAvailablePhoneNumber ?? [];
                $suspectDeterminationEmail = $request->suspectDeterminationEmail ?? [];
                $suspectDeterminationIsExistsEmail = $request->suspectDeterminationIsExistsEmail ?? [];
                $suspectDeterminationIsAvailableEmail = $request->suspectDeterminationIsAvailableEmail ?? [];
                $suspectDeterminationCountryId = $request->suspectDeterminationCountryId ?? [];
                $suspectDeterminationProvinceId = $request->suspectDeterminationProvinceId ?? [];
                $suspectDeterminationRegencyId = $request->suspectDeterminationRegencyId ?? [];
                $suspectDeterminationDistrictId = $request->suspectDeterminationDistrictId ?? [];
                $suspectDeterminationVillageId = $request->suspectDeterminationVillageId ?? [];
                $suspectDeterminationAddress = $request->suspectDeterminationAddress ?? [];
                $suspectDeterminationIsUnknownGender = $request->suspectDeterminationIsUnknownGender ?? [];
                $suspectDeterminationIsUnknownBirthPlace = $request->suspectDeterminationIsUnknownBirthPlace ?? [];
                $suspectDeterminationIsUnknownBirthDate = $request->suspectDeterminationIsUnknownBirthDate ?? [];
                $suspectDeterminationIsUnknownFather = $request->suspectDeterminationIsUnknownFather ?? [];
                $suspectDeterminationIsUnknownMother = $request->suspectDeterminationIsUnknownMother ?? [];
                $suspectDeterminationIsUnknownNationality = $request->suspectDeterminationIsUnknownNationality ?? [];
                $suspectDeterminationIsUnknownMaritalStatus = $request->suspectDeterminationIsUnknownMaritalStatus ?? [];
                $suspectDeterminationIsUnknownAddress = $request->suspectDeterminationIsUnknownAddress ?? [];

                // Make all to collection
                $suspectDeterminationSuspectSourceIdColllection = Collection::make($suspectDeterminationSuspectSourceId);
                $suspectDeterminationIdsColllection = Collection::make($suspectDeterminationIds);
                $suspectDeterminationIdentityStatusColllection = Collection::make($suspectDeterminationIdentityStatus);
                $suspectDeterminationIdentityTypeIdColllection = Collection::make($suspectDeterminationIdentityTypeId);
                $suspectDeterminationIdentityNumberColllection = Collection::make($suspectDeterminationIdentityNumber);
                $suspectDeterminationNameColllection = Collection::make($suspectDeterminationName);
                $suspectDeterminationGenderIdColllection = Collection::make($suspectDeterminationGenderId);
                $suspectDeterminationBirthPlaceColllection = Collection::make($suspectDeterminationBirthPlace);
                $suspectDeterminationBirthDateColllection = Collection::make($suspectDeterminationBirthDate);
                $suspectDeterminationFatherNameColllection = Collection::make($suspectDeterminationFatherName);
                $suspectDeterminationMotherNameColllection = Collection::make($suspectDeterminationMotherName);
                $suspectDeterminationNationalityColllection = Collection::make($suspectDeterminationNationality);
                $suspectDeterminationEthnicIdColllection = Collection::make($suspectDeterminationEthnicId);
                $suspectDeterminationJobIdColllection = Collection::make($suspectDeterminationJobId);
                $suspectDeterminationReligionIdColllection = Collection::make($suspectDeterminationReligionId);
                $suspectDeterminationEducationIdColllection = Collection::make($suspectDeterminationEducationId);
                $suspectDeterminationMaritalStatusIdColllection = Collection::make($suspectDeterminationMaritalStatusId);
                $suspectDeterminationPhoneNumberColllection = Collection::make($suspectDeterminationPhoneNumber);
                $suspectDeterminationIsExistsPhoneNumberColllection = Collection::make($suspectDeterminationIsExistsPhoneNumber);
                $suspectDeterminationIsAvailablePhoneNumberColllection = Collection::make($suspectDeterminationIsAvailablePhoneNumber);
                $suspectDeterminationEmailColllection = Collection::make($suspectDeterminationEmail);
                $suspectDeterminationIsExistsEmailColllection = Collection::make($suspectDeterminationIsExistsEmail);
                $suspectDeterminationIsAvailableEmailColllection = Collection::make($suspectDeterminationIsAvailableEmail);
                $suspectDeterminationCountryIdColllection = Collection::make($suspectDeterminationCountryId);
                $suspectDeterminationProvinceIdColllection = Collection::make($suspectDeterminationProvinceId);
                $suspectDeterminationRegencyIdColllection = Collection::make($suspectDeterminationRegencyId);
                $suspectDeterminationDistrictIdColllection = Collection::make($suspectDeterminationDistrictId);
                $suspectDeterminationVillageIdColllection = Collection::make($suspectDeterminationVillageId);
                $suspectDeterminationAddressColllection = Collection::make($suspectDeterminationAddress);
                $suspectDeterminationIsUnknownGenderColllection = Collection::make($suspectDeterminationIsUnknownGender);
                $suspectDeterminationIsUnknownBirthPlaceColllection = Collection::make($suspectDeterminationIsUnknownBirthPlace);
                $suspectDeterminationIsUnknownBirthDateColllection = Collection::make($suspectDeterminationIsUnknownBirthDate);
                $suspectDeterminationIsUnknownFatherColllection = Collection::make($suspectDeterminationIsUnknownFather);
                $suspectDeterminationIsUnknownMotherColllection = Collection::make($suspectDeterminationIsUnknownMother);
                $suspectDeterminationIsUnknownNationalityColllection = Collection::make($suspectDeterminationIsUnknownNationality);
                $suspectDeterminationIsUnknownMaritalStatusColllection = Collection::make($suspectDeterminationIsUnknownMaritalStatus);
                $suspectDeterminationIsUnknownAddressColllection = Collection::make($suspectDeterminationIsUnknownAddress);

                // zip all collections to one 
                $suspectDeterminations = $suspectDeterminationIdsColllection->zip(
                    $suspectDeterminationSuspectSourceIdColllection,
                    $suspectDeterminationIdentityStatusColllection,
                    $suspectDeterminationIdentityTypeIdColllection,
                    $suspectDeterminationIdentityNumberColllection,
                    $suspectDeterminationNameColllection,
                    $suspectDeterminationGenderIdColllection,
                    $suspectDeterminationBirthPlaceColllection,
                    $suspectDeterminationBirthDateColllection,
                    $suspectDeterminationFatherNameColllection,
                    $suspectDeterminationMotherNameColllection,
                    $suspectDeterminationEthnicIdColllection,
                    $suspectDeterminationJobIdColllection,
                    $suspectDeterminationReligionIdColllection,
                    $suspectDeterminationEducationIdColllection,
                    $suspectDeterminationMaritalStatusIdColllection,
                    $suspectDeterminationPhoneNumberColllection,
                    $suspectDeterminationIsExistsPhoneNumberColllection,
                    $suspectDeterminationIsAvailablePhoneNumberColllection,
                    $suspectDeterminationEmailColllection,
                    $suspectDeterminationIsExistsEmailColllection,
                    $suspectDeterminationIsAvailableEmailColllection,
                    $suspectDeterminationCountryIdColllection,
                    $suspectDeterminationProvinceIdColllection,
                    $suspectDeterminationRegencyIdColllection,
                    $suspectDeterminationDistrictIdColllection,
                    $suspectDeterminationVillageIdColllection,
                    $suspectDeterminationAddressColllection,
                    $suspectDeterminationIsUnknownGenderColllection,
                    $suspectDeterminationIsUnknownBirthPlaceColllection,
                    $suspectDeterminationIsUnknownBirthDateColllection,
                    $suspectDeterminationIsUnknownFatherColllection,
                    $suspectDeterminationIsUnknownMotherColllection,
                    $suspectDeterminationIsUnknownMaritalStatusColllection,
                    $suspectDeterminationIsUnknownAddressColllection,
                    $suspectDeterminationNationalityColllection,
                    $suspectDeterminationIsUnknownNationalityColllection
                )->map(function ($item) {
                    return [
                        'id' => $item[0],
                        'suspect_source_id' => $item[1],
                        'identity_status' => $item[2],
                        'identity_type_id' => $item[3],
                        'identity_number' => $item[4],
                        'name' => $item[5],
                        'gender_id' => $item[6],
                        'birth_place' => $item[7],
                        'birth_date' => $item[8],
                        'father_name' => $item[9],
                        'mother_name' => $item[10],
                        'ethnic_id' => $item[11],
                        'job_id' => $item[12],
                        'religion_id' => $item[13],
                        'education_id' => $item[14],
                        'marital_status_id' => $item[15],
                        'phone_number' => $item[16],
                        'is_exists_phone_number' => $item[17],
                        'is_available_phone_number' => $item[18],
                        'email' => $item[19],
                        'is_exists_email' => $item[20],
                        'is_available_email' => $item[21],
                        'country_id' => $item[22],
                        'province_id' => $item[23],
                        'regency_id' => $item[24],
                        'district_id' => $item[25],
                        'village_id' => $item[26],
                        'address' => $item[27],
                        'is_unknown_gender' => $item[28],
                        'is_unknown_birth_place' => $item[29],
                        'is_unknown_birth_date' => $item[30],
                        'is_unknown_father' => $item[31],
                        'is_unknown_mother' => $item[32],
                        'is_unknown_marital_status' => $item[33],
                        'is_unknown_address' => $item[34],
                        'nationality' => $item[35],
                        'is_unknown_nationality' => $item[36],
                    ];
                });
              
                foreach($suspectDeterminations as $suspectDetermination){
                    $suspectData = [];
                    
                    if(empty($suspectDetermination['id']) && $suspectDetermination['suspect_source_id'] == '3')
                    {
                        $suspectData = [
                            'id' => Uuid::generate()->string,
                            'accident_id' => $accidentId,
                            'identity_number' => $suspectDetermination['identity_number'],
                            'name' => $suspectDetermination['name'],
                            'birth_place' => $suspectDetermination['birth_place'],
                            'birth_date' => $suspectDetermination['birth_date'],
                            'father_name' => $suspectDetermination['father_name'],
                            'mother_name' => $suspectDetermination['mother_name'],
                            'nationality' => $suspectDetermination['nationality'],
                            'phone_number' => $suspectDetermination['phone_number'],
                            'email_address' => $suspectDetermination['email'],
                            'address' => $suspectDetermination['address'],
                            'identity_type_id' => $suspectDetermination['identity_type_id'],
                            'gender_id' => $suspectDetermination['gender_id'],
                            'ethnic_id' => $suspectDetermination['ethnic_id'],
                            'job_id' => $suspectDetermination['job_id'],
                            'religion_id' => $suspectDetermination['religion_id'],
                            'education_id' => $suspectDetermination['education_id'],
                            'marital_status_id' => $suspectDetermination['marital_status_id'],
    
                            'status' => $suspectDetermination['identity_status'],
                            'flag' => Suspect::getEnumOption('flag', 'TERSANGKA'),
                            'class' => Suspect::getEnumOption('class', 'DETERMINATION'),
                            'group' => Suspect::getEnumOption('class', 'LAPORAN_HASIL_GELAR_PERKARA'),
                            'insert_method' => Suspect::getEnumOption('insert_method', 'MANUAL'),
    
                            'country_id' => $suspectDetermination['country_id'],
                            'province_id' => $suspectDetermination['province_id'],
                            'regency_id' => $suspectDetermination['regency_id'],
                            'district_id' => $suspectDetermination['district_id'],
                            'village_id' => $suspectDetermination['village_id'],
    
                            'suspect_source_id' => $suspectDetermination['suspect_source_id'],

                            'properties' => [
                                'is_exists_phone_number' => (!empty($suspectDetermination['is_exists_phone_number'])) ? filter_var($suspectDetermination['is_exists_phone_number'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_available_phone_number' => (!empty($suspectDetermination['is_available_phone_number'])) ? filter_var($suspectDetermination['is_available_phone_number'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_exists_email' => (!empty($suspectDetermination['is_exists_email'])) ? filter_var($suspectDetermination['is_exists_email'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_available_email' => (!empty($suspectDetermination['is_available_email'])) ? filter_var($suspectDetermination['is_available_email'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_gender' => (!empty($suspectDetermination['is_unknown_gender'])) ? filter_var($suspectDetermination['is_unknown_gender'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_birth_place' => (!empty($suspectDetermination['is_unknown_birth_place'])) ? filter_var($suspectDetermination['is_unknown_birth_place'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_birth_date' => (!empty($suspectDetermination['is_unknown_birth_date'])) ? filter_var($suspectDetermination['is_unknown_birth_date'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_father' => (!empty($suspectDetermination['is_unknown_father'])) ? filter_var($suspectDetermination['is_unknown_father'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_mother' => (!empty($suspectDetermination['is_unknown_mother'])) ? filter_var($suspectDetermination['is_unknown_mother'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_nationality' => (!empty($suspectDetermination['is_unknown_nationality'])) ? filter_var($suspectDetermination['is_unknown_nationality'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_marital_status' => (!empty($suspectDetermination['is_unknown_marital_status'])) ? filter_var($suspectDetermination['is_unknown_marital_status'], FILTER_VALIDATE_BOOLEAN) : null,
                                'is_unknown_address' => (!empty($suspectDetermination['is_unknown_address'])) ? filter_var($suspectDetermination['is_unknown_address'], FILTER_VALIDATE_BOOLEAN) : null,
                            ],
                        ];

                        $suspect = Suspect::create(
                            $suspectData
                        );

                        $suspectIds[] = $suspect->id;
                    }else if($suspectDetermination['suspect_source_id'] == '2'){
                        $suspect = Suspect::where('id', $suspectDetermination['id'])->first();
                        
                        $suspect->update(
                            [
                                'suspect_source_id' => $suspectDetermination['suspect_source_id'],

                                'status' => Suspect::getEnumOption('status', 'IMPORT'),
                                'flag' => Suspect::getEnumOption('flag', 'TERSANGKA'),
                                'class' => Suspect::getEnumOption('class', 'DETERMINATION'),
                                'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
                                'insert_method' => Suspect::getEnumOption('insert_method', 'IMPORT'),

                                'properties' => [
                                    'is_exists_phone_number' => null,
                                    'is_available_phone_number' => null,
                                    'is_exists_email' => null,
                                    'is_available_email' => null,
                                    'is_unknown_gender' => null,
                                    'is_unknown_birth_place' => null,
                                    'is_unknown_birth_date' => null,
                                    'is_unknown_father' => null,
                                    'is_unknown_mother' => null,
                                    'is_unknown_nationality' => null,
                                    'is_unknown_marital_status' => null,
                                    'is_unknown_address' => null,
                                ],
                            ]
                        );

                        $suspectIds[] = $suspect->id;
                    }else if(!empty($suspectDetermination['id']) && $suspectDetermination['suspect_source_id'] == '1')
                    {
                        $witness = Witness::where('id',$suspectDetermination['id'])->first();

                        $suspectData = [
                            'id' => Uuid::generate()->string,
                            'accident_id' => $accidentId,
                            'identity_number' => $witness->identity_number,
                            'name' => $witness->name,
                            'birth_place' => $witness->birth_place,
                            'birth_date' => $witness->birth_date,
                            'phone_number' => $witness->phone_number,
                
                            'address' => $witness->address,
                            'identity_type_id' => $witness->identity_type_id,
                            'gender_id' => $witness->gender_id,
                            'ethnic_id' => $witness->ethnic_id,
                            'job_id' => $witness->job_id,
                            'religion_id' => $witness->religion_id,
                            'education_id' => $witness->education_id,
                            'marital_status_id' => $witness->marital_status_id,
    
                            'status' => Suspect::getEnumOption('status', 'IMPORT'),
                            'flag' => Suspect::getEnumOption('flag', 'TERSANGKA'),
                            'class' => Suspect::getEnumOption('class', 'DETERMINATION'),
                            'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
                            'insert_method' => Suspect::getEnumOption('insert_method', 'IMPORT'),
    
                            'country_id' => $witness->country_id,
                            'province_id' => $witness->province_id,
                            'regency_id' => $witness->regency_id,
                            'district_id' => $witness->district_id,
                            'village_id' => $witness->village_id,
    
                            'suspect_source_id' => $suspectDetermination['suspect_source_id'],

                            'properties' => [
                                'is_exists_phone_number' => null,
                                'is_available_phone_number' => null,
                                'is_exists_email' => null,
                                'is_available_email' => null,
                                'is_unknown_gender' => null,
                                'is_unknown_birth_place' => null,
                                'is_unknown_birth_date' => null,
                                'is_unknown_father' => null,
                                'is_unknown_mother' => null,
                                'is_unknown_nationality' => null,
                                'is_unknown_marital_status' => null,
                                'is_unknown_address' => null,
                            ],
                        ];

                        $suspect = Suspect::create(
                            $suspectData
                        );

                        $suspectIds[] = $suspect->id;
                    }
                }
            }

            // SUSPECT ARREST
            if($caseDegreeTypeId == "4"){
                $arrestSuspectIds = $request->arrestSuspects ?? [];

                foreach($arrestSuspectIds as $arrestSuspectId){
                    $suspect = Suspect::where('id', $arrestSuspectId)->first();

                    $suspect->update([
                        'class' => Suspect::getEnumOption('class', 'ARREST'),
                        'group' => Suspect::getEnumOption('group', 'LAPORAN_HASIL_GELAR_PERKARA'),
                    ]);

                    $suspectIds[] = $suspect->id;
                }
            }

            // SUSPECT REVOCATION
            if($caseDegreeTypeId == "16"){
                $revocationSuspectIds = $request->revocationSuspects ?? [];

                foreach($revocationSuspectIds as $revocationSuspectId){
                    $suspect = Suspect::where('id', $revocationSuspectId)->first();

                    $suspect->update([
                        'class' => Suspect::getEnumOption('class', 'REVOCATION'),
                        'group' => Suspect::getEnumOption('class', 'LAPORAN_HASIL_GELAR_PERKARA'),
                    ]);

                    $suspectIds[] = $suspect->id;
                }
            }

            //Attach Suspect
            foreach ($suspectIds as $suspectId) {
                $laporanHasilGelarPerkaraDocument->suspects()->attach($suspectId);
            }

            DB::commit();
        }catch(\Exception $e){
            DB::rollback();
            return redirect()->back()->with('error', 'Terjadi kesalahan pada saat menyimpan data.');
        }

        // Redirect
        return redirect()->route('view_produktivitas_accident', ['accident_id' => $accidentId]);
    }

    public function show($id)
    {
        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));
        $laporanHasilGelarPerkaraDocumentId = $id;

        $laporanHasilGelarPerkaraDocument = LaporanHasilGelarPerkaraDocument::with(['laporanHasilGelarPerkaraDocumentOfficers', 'caseDegreeType', 'timezone', 'suratPerintahPenyidikanDocument'])->where('id', $laporanHasilGelarPerkaraDocumentId)->first();
        $accident = Accident::with(['polres', 'polres.polda'])->where('id', $accidentId)->first();

        $viewData =[
            'accidentId' => $accidentId,
            'accident' => $accident,
            'laporanHasilGelarPerkaraDocument' => $laporanHasilGelarPerkaraDocument,
            'laporanHasilGelarPerkaraDocumentId' => $laporanHasilGelarPerkaraDocumentId,
        ];

        return view('docs.laporan-hasil-gelar-perkara-document.show', $viewData);
    }

    public function edit($id)
    {
        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));
        $accident = Accident::where('id',$accidentId)->first();
        $police = Police::with('parent')->where('id', $accident->polres_id)->first();
  
        $laporanHasilGelarPerkaraDocumentId = $id;
        $laporanHasilGelarPerkaraDocument = LaporanHasilGelarPerkaraDocument::with(['suspects', 'laporanHasilGelarPerkaraDocumentOfficers', 'laporanHasilGelarPerkaraDocumentFiles'])->where('id', $laporanHasilGelarPerkaraDocumentId)->first();
        $positions = Position::where('is_active', true)->orderBy('sort')->get();

        $authorizedSignatories = Officer::withRelated()
            ->selectFullName()
            ->where('police_id', $accident->polres_id)
            ->whereHasUserActive()
            ->hasDataComplete()
            ->signatory()
            ->active()
            ->valid()
            ->orderBy('first_name')
            ->get();

        $ranks = Rank::where('is_active', true)
            ->wherePolri()
            ->orderBy('sort')
            ->get();

        $positions = Position::whereIn('police_id', [$police->id, $police->parent->id ?? null, $police->parent->parent->id ?? null])
            ->where('is_active', true)
            ->orderBy('sort')
            ->get();

        $caseDegreeTypes = CaseDegreeType::where('is_active', true)
            ->orderBy('sort')
            ->get();

        $timezones = Timezone::where('is_active', true)
                        ->orderBy('sort')
                        ->get();

        $suspectSources = SuspectSource::where('group', 'LAPORAN_HASIL_GELAR_PERKARA')
                            ->where('is_active', true)
                            ->orderBy('sort')
                            ->get();

        $identityTypes = IdentityType::where('is_active', true)
                            ->orderBy('sort')
                            ->get();

        $genders = Gender::where('is_active', true)
                        ->orderBy('sort')
                        ->get();

        $ethnics = Ethnic::where('is_active', true)
                        ->orderBy('sort')
                        ->get();

        $jobs = Job::where('is_active', true)
                        ->orderBy('sort')
                        ->get();

        $religions = Religion::where('is_active', true)
                            ->orderBy('sort')
                            ->get();

        $educations = Education::where('is_active', true)
                                ->orderBy('sort')
                                ->get();

        $maritalStatuses = MaritalStatus::where('is_active', true)
                                    ->orderBy('sort')
                                    ->get();

        $countries = Location::where('is_active', true)
                                ->where('class', 'COUNTRY')
                                ->orderBy('sort')
                                ->get();

        $suspects = Suspect::where('accident_id', $accidentId)->get();

        $witnesses = Witness::where('accident_id', $accidentId)->get();
        
        $suratPerintahPenyidikanDocuments = SuratPerintahPenyidikanDocument::where('accident_id', $accidentId)
            ->whereIn('status_id', $this->docService->requiredDocumentStatusIds)
            ->get();

        $viewData =[
            'authorizedSignatories' => $authorizedSignatories,
            'accidentId' => $accidentId,
            'accident' => $accident,
            'laporanHasilGelarPerkaraDocument' => $laporanHasilGelarPerkaraDocument,
            'laporanHasilGelarPerkaraDocumentId' => $laporanHasilGelarPerkaraDocumentId,
            'ranks' => $ranks,
            'positions' => $positions,
            'officers' => $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentOfficers,
            'suratPerintahPenyidikanDocuments' => $suratPerintahPenyidikanDocuments,
            'timezones' => $timezones,
            'suspectSources' => $suspectSources,
            'identityTypes' => $identityTypes,
            'genders' => $genders,
            'ethnics' => $ethnics,
            'jobs' => $jobs,
            'religions' => $religions,
            'educations' => $educations,
            'maritalStatuses' => $maritalStatuses,
            'countries' => $countries,
            'caseDegreeTypes' => $caseDegreeTypes,
            'laporanHasilGelarPerkaraDocumentOfficers' => $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentOfficers,
            'suspects' => $suspects,
            'arrerstedSuspects' => $suspects->where('flag', Suspect::getEnumOption('flag', 'TERSANGKA')),
            'revocationSuspects' => $suspects->where('flag', Suspect::getEnumOption('flag', 'TERSANGKA')),
            'witnesses' => $witnesses
        ];
       
        return view('docs.laporan-hasil-gelar-perkara-document.edit', $viewData);
    }

    public function update(Request $request, $id)
    {
        // Validation
        $validator = $this->validateForm($request);
        
        if ($validator->fails()) {
            return redirect()->back()->withErrors($validator)->withInput();
        }

        // Get URL Parameter
        $accidentId = htmlspecialchars(request()->query('accident_id'));
        $laporanHasilGelarPerkaraDocumentId = $id;

        // Define & Sanitize Text Input
        $user = Auth::user();
        $suratPerintahPenyidikanDocumentId = htmlspecialchars($request->suratPerintahPenyidikanDocument);
        $documentType = htmlspecialchars($request->documentType);
        $caseDegreeTypeId = htmlspecialchars($request->caseDegreeType);
        $caseDegreeInviteReference = htmlspecialchars($request->caseDegreeInviteReference);
        $caseDegreeInviteDate = htmlspecialchars($request->caseDegreeInviteDate);

        $date = htmlspecialchars($request->date);
        $time = htmlspecialchars($request->time);
        $timezoneId = htmlspecialchars($request->timezone);
        $place = htmlspecialchars($request->place);
        $caseDegreeLeader = htmlspecialchars($request->caseDegreeLeader);
        $attendees = htmlspecialchars($request->attendees);

        $discussion = htmlspecialchars($request->discussion);
        $conclusion = htmlspecialchars($request->conclusion);
        $closing = htmlspecialchars($request->closing);

        $documentDate = htmlspecialchars($request->documentDate);
        $signatoryId = htmlspecialchars($request->signatory);
        $isUpperUnitDocument = htmlspecialchars($request->isUpperUnitDocument);
        $upperUnitOfficerName = htmlspecialchars($request->upperUnitOfficerName);
        $upperUnitOfficerRegisterNumber = htmlspecialchars($request->upperUnitOfficerRegisterNumber);
        $upperUnitOfficerRank = htmlspecialchars($request->upperUnitOfficerRank);
        $upperUnitOfficerPosition = htmlspecialchars($request->upperUnitOfficerPosition);
        $isOnBehalfOfSuperiorOfficer = htmlspecialchars($request->isOnBehalfOfSuperiorOfficer);
        $upperUnitSuperiorOfficerName = htmlspecialchars($request->upperUnitSuperiorOfficerName);

        $photos = $request->file('photos');

        $isLegacy = filter_var($request->isLegacy, FILTER_VALIDATE_BOOLEAN);

        DB::beginTransaction();
        try{
            // Store to database
            $laporanHasilGelarPerkaraDocument = LaporanHasilGelarPerkaraDocument::where('id', $laporanHasilGelarPerkaraDocumentId)->first();

            $laporanHasilGelarPerkaraDocument->update([
                'accident_id' => $accidentId,
                'surat_perintah_penyidikan_document_id' => $suratPerintahPenyidikanDocumentId,
                'document_date' => $documentDate,
                'document_type' => $documentType,
                'case_degree_type_id' => $caseDegreeTypeId,

                'case_degree_invite_reference' => $caseDegreeInviteReference,
                'case_degree_invite_date' => $caseDegreeInviteDate,

                'date'=> $date,
                'time' => $time,
                'timezone_id' => $timezoneId,
                'place' => $place,
                'case_degree_leader' => $caseDegreeLeader,
                'attendees' => $attendees,

                'discussion' => $discussion,
                'conclusion' => $conclusion,
                'closing' => $closing,

                'is_legacy' => $isLegacy,
            ]);

            $laporanHasilGelarPerkaraDocumentId = $laporanHasilGelarPerkaraDocument->id;

            // Image Upload
            if($photos){
                //remove old image
                $laporanHasilGelarPerkaraDocumentOldImages = $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentFiles()
                                                                ->where('type', LaporanHasilGelarPerkaraDocumentFile::getEnumOption('type', 'IMAGE'))
                                                                ->get();
                foreach($laporanHasilGelarPerkaraDocumentOldImages as $laporanHasilGelarPerkaraDocumentOldImage){
                    $path = public_path('documents/laporan-hasil-gelar-perkara-document/images/'.$laporanHasilGelarPerkaraDocumentOldImage->name);
                    if(file_exists($path)){
                        unlink($path);
                    }
                }
                $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentFiles()->delete();

                //add new image
                foreach($photos as $photo){
                    $photoOriginalName = $photo->getClientOriginalName();
                    $photoHashName = $photo->hashName();
                    $photoExtension = $photo->getClientOriginalExtension();
                    $photoMimeType = $photo->getMimeType();
                    $photoSize = $photo->getSize();

                    $path = public_path('documents/laporan-hasil-gelar-perkara-document/images/');

                    $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentFiles()->create([
                        'laporan_hasil_gelar_perkara_document_id' => $laporanHasilGelarPerkaraDocumentId,
                        'name' => $photoHashName,
                        'original_name' => $photoOriginalName,
                        'extension' => $photoExtension,
                        'mimetype' => $photoMimeType,
                        'size' => $photoSize,
                        'type' => LaporanHasilGelarPerkaraDocumentFile::getEnumOption('type', 'IMAGE'),
                    ]);

                    $photo->move($path, $photoHashName);
                }
            }

            //SIGNATORY
            $signatoryCreateData = [];
            if($isUpperUnitDocument == 'true'){
                $rank = Rank::where('id', $upperUnitOfficerRank)->first();
                $isOnBehalf = ($isOnBehalfOfSuperiorOfficer == 'true') ? true : false;

                $signatoryCreateData = [
                    'laporan_hasil_gelar_perkara_document_id' => $laporanHasilGelarPerkaraDocumentId,
                    'register_number' => $upperUnitOfficerRegisterNumber,

                    'first_title' => null,
                    'first_name' => $upperUnitOfficerName,
                    'last_name' => null,
                    'last_title' => null,

                    'rank_id' => $rank->id,
                    'position_id' => $upperUnitOfficerPosition,
                    'is_on_behalf' => $isOnBehalf,
                    'on_behalf_name' => $upperUnitSuperiorOfficerName,

                    'police_id' => null,
                    'status' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('status', 'UPPER_UNIT_LEVEL'),
                    'flag' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('flag', 'UPPER_UNIT_LEVEL'),
                    'class' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'SIGNATORY'),
                    'insert_method' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'MANUAL'),
                ];
            }else{
                $signatory = Officer::where('id',$signatoryId)->first();

                $signatoryCreateData = [
                    'laporan_hasil_gelar_perkara_document_id' => $laporanHasilGelarPerkaraDocumentId,
                    'register_number' => $signatory->register_number,

                    'first_title' => $signatory->first_title,
                    'first_name' => $signatory->first_name,
                    'last_name' => $signatory->last_name,
                    'last_title' => $signatory->last_title,

                    'rank_id' => $signatory->rank_id,
                    'position_id' => $signatory->position_id,
                    'phone_number' => $signatory->phone_number,
                    'email' => $signatory->email,

                    'police_id' => $signatory->police_id,
                    'status' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('status', 'PRESENT'),
                    'flag' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('flag', 'INTERNAL'),
                    'class' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'SIGNATORY'),
                    'insert_method' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'IMPORT'),
                ];
            }
            
            $laporanHasilGelarPerkaraDocument->laporanHasilGelarPerkaraDocumentOfficers()
                ->updateOrCreate(
                    [
                        'class' => LaporanHasilGelarPerkaraDocumentOfficer::getEnumOption('class', 'SIGNATORY')
                    ],
                    $signatoryCreateData
                );

            $suspectIds = [];

            // SUSPECT DETERMINATION
            if($caseDegreeTypeId == "1"){
                $suspectDeterminationIsNewRecord = $request->suspectDeterminationIsNewRecord ?? [];
                $suspectDeterminationSuspectSourceId = $request->suspectDeterminationSuspectSourceId ?? [];
                $suspectDeterminationIds = $request->suspectDeterminationIds ?? [];
                $suspectDeterminationIdentityStatus = $request->suspectDeterminationIdentityStatus ?? [];
                $suspectDeterminationIdentityTypeId = $request->suspectDeterminationIdentityTypeId ?? [];
                $suspectDeterminationIdentityNumber = $request->suspectDeterminationIdentityNumber ?? [];
                $suspectDeterminationName = $request->suspectDeterminationName ?? [];
                $suspectDeterminationGenderId = $request->suspectDeterminationGenderId ?? [];
                $suspectDeterminationBirthPlace = $request->suspectDeterminationBirthPlace ?? [];
                $suspectDeterminationBirthDate = $request->suspectDeterminationBirthDate ?? [];
                $suspectDeterminationFatherName = $request->suspectDeterminationFatherName ?? [];
                $suspectDeterminationMotherName = $request->suspectDeterminationMotherName ?? [];
                $suspectDeterminationNationality = $request->suspectDeterminationNationality ?? [];
                $suspectDeterminationEthnicId = $request->suspectDeterminationEthnicId ?? [];
                $suspectDeterminationJobId = $request->suspectDeterminationJobId ?? [];
                $suspectDeterminationReligionId = $request->suspectDeterminationReligionId ?? [];
                $suspectDeterminationEducationId = $request->suspectDeterminationEducationId ?? [];
                $suspectDeterminationMaritalStatusId = $request->suspectDeterminationMaritalStatusId ?? [];
                $suspectDeterminationPhoneNumber = $request->suspectDeterminationPhoneNumber ?? [];
                $suspectDeterminationIsExistsPhoneNumber = $request->suspectDeterminationIsExistsPhoneNumber ?? [];
                $suspectDeterminationIsAvailablePhoneNumber = $request->suspectDeterminationIsAvailablePhoneNumber ?? [];
                $suspectDeterminationEmail = $request->suspectDeterminationEmail ?? [];
                $suspectDeterminationIsExistsEmail = $request->suspectDeterminationIsExistsEmail ?? [];
                $suspectDeterminationIsAvailableEmail = $request->suspectDeterminationIsAvailableEmail ?? [];
                $suspectDeterminationCountryId = $request->suspectDeterminationCountryId ?? [];
                $suspectDeterminationProvinceId = $request->suspectDeterminationProvinceId ?? [];
                $suspectDeterminationRegencyId = $request->suspectDeterminationRegencyId ?? [];
                $suspectDeterminationDistrictId = $request->suspectDeterminationDistrictId ?? [];
                $suspectDeterminationVillageId = $request->suspectDeterminationVillageId ?? [];
                $suspectDeterminationAddress = $request->suspectDeterminationAddress ?? [];
                $suspectDeterminationIsUnknownGender = $request->suspectDeterminationIsUnknownGender ?? [];
                $suspectDeterminationIsUnknownBirthPlace = $request->suspectDeterminationIsUnknownBirthPlace ?? [];
                $suspectDeterminationIsUnknownBirthDate = $request->suspectDeterminationIsUnknownBirthDate ?? [];
                $suspectDeterminationIsUnknownFather = $request->suspectDeterminationIsUnknownFather ?? [];
                $suspectDeterminationIsUnknownMother = $request->suspectDeterminationIsUnknownMother ?? [];
                $suspectDeterminationIsUnknownNationality = $request->suspectDeterminationIsUnknownNationality ?? [];
                $suspectDeterminationIsUnknownMaritalStatus = $request->suspectDeterminationIsUnknownMaritalStatus ?? [];
                $suspectDeterminationIsUnknownAddress = $request->suspectDeterminationIsUnknownAddress ?? [];

                // Make all to collection
                $suspectDeterminationIsNewRecordColllection = Collection::make($suspectDeterminationIsNewRecord);
                $suspectDeterminationSuspectSourceIdColllection = Collection::make($suspectDeterminationSuspectSourceId);
                $suspectDeterminationIdsColllection = Collection::make($suspectDeterminationIds);
                $suspectDeterminationIdentityStatusColllection = Collection::make($suspectDeterminationIdentityStatus);
                $suspectDeterminationIdentityTypeIdColllection = Collection::make($suspectDeterminationIdentityTypeId);
                $suspectDeterminationIdentityNumberColllection = Collection::make($suspectDeterminationIdentityNumber);
                $suspectDeterminationNameColllection = Collection::make($suspectDeterminationName);
                $suspectDeterminationGenderIdColllection = Collection::make($suspectDeterminationGenderId);
                $suspectDeterminationBirthPlaceColllection = Collection::make($suspectDeterminationBirthPlace);
                $suspectDeterminationBirthDateColllection = Collection::make($suspectDeterminationBirthDate);
                $suspectDeterminationFatherNameColllection = Collection::make($suspectDeterminationFatherName);
                $suspectDeterminationMotherNameColllection = Collection::make($suspectDeterminationMotherName);
                $suspectDeterminationNationalityColllection = Collection::make($suspectDeterminationNationality);
                $suspectDeterminationEthnicIdColllection = Collection::make($suspectDeterminationEthnicId);
                $suspectDeterminationJobIdColllection = Collection::make($suspectDeterminationJobId);
                $suspectDeterminationReligionIdColllection = Collection::make($suspectDeterminationReligionId);
                $suspectDeterminationEducationIdColllection = Collection::make($suspectDeterminationEducationId);
                $suspectDeterminationMaritalStatusIdColllection = Collection::make($suspectDeterminationMaritalStatusId);
                $suspectDeterminationPhoneNumberColllection = Collection::make($suspectDeterminationPhoneNumber);
                $suspectDeterminationIsExistsPhoneNumberColllection = Collection::make($suspectDeterminationIsExistsPhoneNumber);
                $suspectDeterminationIsAvailablePhoneNumberColllection = Collection::make($suspectDeterminationIsAvailablePhoneNumber);
                $suspectDeterminationEmailColllection = Collection::make($suspectDeterminationEmail);
                $suspectDeterminationIsExistsEmailColllection = Collection::make($suspectDeterminationIsExistsEmail);
                $suspectDeterminationIsAvailableEmailColllection = Collection::make($suspectDeterminationIsAvailableEmail);
                $suspectDeterminationCountryIdColllection = Collection::make($suspectDeterminationCountryId);
                $suspectDeterminationProvinceIdColllection = Collection::make($suspectDeterminationProvinceId);
                $suspectDeterminationRegencyIdColllection = Collection::make($suspectDeterminationRegencyId);
                $suspectDeterminationDistrictIdColllection = Collection::make($suspectDeterminationDistrictId);
                $suspectDeterminationVillageIdColllection = Collection::make($suspectDeterminationVillageId);
                $suspectDeterminationAddressColllection = Collection::make($suspectDeterminationAddress);
                $suspectDeterminationIsUnknownGenderColllection = Collection::make($suspectDeterminationIsUnknownGender);
                $suspectDeterminationIsUnknownBirthPlaceColllection = Collection::make($suspectDeterminationIsUnknownBirthPlace);
                $suspectDeterminationIsUnknownBirthDateColllection = Collection::make($suspectDeterminationIsUnknownBirthDate);
                $suspectDeterminationIsUnknownFatherColllection = Collection::make($suspectDeterminationIsUnknownFather);
                $suspectDeterminationIsUnknownMotherColllection = Collection::make($suspectDeterminationIsUnknownMother);
                $suspectDeterminationIsUnknownNationalityColllection = Collection::make($suspectDeterminationIsUnknownNationality);
                $suspectDeterminationIsUnknownMaritalStatusColllection = Collection::make($suspectDeterminationIsUnknownMaritalStatus);
                $suspectDeterminationIsUnknownAddressColllection = Collection::make($suspectDeterminationIsUnknownAddress);

                // zip all collections to one 
                $suspectDeterminations = $suspectDeterminationIdsColllection->zip(
                    $suspectDeterminationSuspectSourceIdColllection,
                    $suspectDeterminationIdentityStatusColllection,
                    $suspectDeterminationIdentityTypeIdColllection,
                    $suspectDeterminationIdentityNumberColllection,
                    $suspectDeterminationNameColllection,
                    $suspectDeterminationGenderIdColllection,
                    $suspectDeterminationBirthPlaceColllection,
                    $suspectDeterminationBirthDateColllection,
                    $suspectDeterminationFatherNameColllection,
                    $suspectDeterminationMotherNameColllection,
                    $suspectDeterminationEthnicIdColllection,
                    $suspectDeterminationJobIdColllection,
                    $suspectDeterminationReligionIdColllection,
                    $suspectDeterminationEducationIdColllection,
                    $suspectDeterminationMaritalStatusIdColllection,
                    $suspectDeterminationPhoneNumberColllection,
                    $suspectDeterminationIsExistsPhoneNumberColllection,
                    $suspectDeterminationIsAvailablePhoneNumberColllection,
                    $suspectDeterminationEmailColllection,
                    $suspectDeterminationIsExistsEmailColllection,
                    $suspectDeterminationIsAvailableEmailColllection,

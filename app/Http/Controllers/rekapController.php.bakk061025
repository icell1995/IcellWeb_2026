    /**
     * Display the specified resource.
     *
     * @param  int  $id
     * @return \Illuminate\Http\Response
     */
    public function show($id)
    {
        // $get_surat_tugas= DB::select('select * from surat_tugas left join officers on surat_tugas.officer_id=officers.id where accident_id=\''.$id.'\' ');
        // // dd($get_surat_tugas);
        // $accident= Accident::find($id);

        $accident = DB::select('select accidents.id as id , no_lp, accidents.accident_date as accident_date,accidents.created_at as created_at,report_date,selra_flag,ref.name as selra_name from accidents join ref on accidents.selra_flag=ref.id where accidents.id = \''.$id.'\'');

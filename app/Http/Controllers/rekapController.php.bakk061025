        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from surat_penyidikan_lanjutan a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from berita_penghentian_penyidikan a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from surat_pernyataan a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from surat_kesepakatan_perdamaian a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all

        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from surat_penetapan_tersangka a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from surat_perintah_penangkapan a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from surat_membawa_menghadapkan a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from surat_pelepasan_tersangka a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from berita_acara_penangkapan a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'
        union all
        select a.id as id,accident_id,a.created_at as created_at,a.name as dok_name ,initial, ref.name ref_name, officers.first_name ||\' \' || officers.last_name  as officer_name from berita_pelepasan_tersangka a left join ref on a.category = ref.id left join officers on a.created_by = officers.id where accident_id = \''.$id.'\'

        ) dokumen
        order by dokumen.created_at desc
        ');
            // dd($test);
        $data['dokumen']=$dokumen;

        return view('rekap.rekap-show', $data);
    }


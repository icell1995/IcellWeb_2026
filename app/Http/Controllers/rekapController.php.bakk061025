    public function search_rekap(Request $request)
    {
        $user=Auth::getUser();
        $checkuser=$user->role_id;
        $no_lp = $request->input('no_lp');
        $polres = $request->input('polres');
        $polda = $request->input('polda');
        $checkTanggal = $request->input('date_from');//for check date if user click the form
        $date_from = date('Y-m-d', strtotime($request->input('date_from')));
        // $date_from=Carbon::parse($request->date_from)->format('Y-m-d');
        $date_to = date('Y-m-d', strtotime($request->input('date_to')));
        // $date_to=Carbon::parse($request->date_to)->format('Y-m-d');
        $checkstatus = $request->input('status');
        // dd($tanggal);

        if($no_lp == null){
            $no_lp = '-';
        }

        if($checkTanggal == null){
            $checkTanggal = '-';
        }

        if($date_from == null){
            $date_from = '-';
        }

        if($date_to == null){
            $date_to = '-';
        }

        if($checkstatus == null){
            $checkstatus = '-';
        }

        if($polda != null){
            $polda = $polda;
        }else{
            $polda = '-';
        }


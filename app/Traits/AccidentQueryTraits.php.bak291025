<?php

namespace App\Traits;

use Carbon\Carbon;
use Illuminate\Database\Query\Builder;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;

trait AccidentQueryTraits
{
    protected function getAccidentQuery()
    {
        return DB::table('accidents as a')
            ->join('polres', 'a.polres_id', '=', 'polres.id')
            ->join('polda', 'polres.polda_id', '=', 'polda.id')
            ->join('ref', 'a.selra_flag', '=', 'ref.id')
            ->select([
                'a.id',
                'polda.name as polda_name',
                'polres.name as polres_name',
                'ref.id as selra_id',
                'a.rank_id',
                'a.no_lp',
                'a.md',
                'a.lb',
                'a.lr',
                'a.road_name',
                DB::raw("to_char(a.accident_date, 'DD-MM-YYYY') as accident_date"),
                'ref.name as selra',
                DB::raw("to_char(a.last_update, 'DD-MM-YYYY HH24:MI:SS') as accident_last_update"),
                DB::raw("CONCAT(officer_first_name, ' ', officer_last_name) as officer_name"),
            ]);
    }

    protected function getAccidents()
    {
        return DB::cursor(
            "
            SELECT a.id as id,
            polda.name as polda_name,
            polres.name as polres_name,
            ref.id as selra_id,
            a.rank_id,
            a.no_lp,a.md,a.lb,a.lr,a.road_name ,
            to_char(a.accident_date, 'DD-MM-YYYY') as accident_date,
            ref.name as selra,
            to_char(a.last_update, 'DD-MM-YYYY HH24:ii:ss') as accident_last_update,
            CONCAT(officer_first_name, ' ',officer_last_name) as officer_name
            from accidents as a join polres on a.polres_id = polres.id
            left join polda on polda.id = polres.polda_id
            left join ref on a.selra_flag = ref.id
            order by a.accident_date desc
            limit 200000
            "
        );
    }

    protected function applyFilters($query, array $filters)
    {
        return $query
            ->when(($filters['polda'] ?? '-') != '-', fn($q) => $q->where('polda.id', $filters['polda']))
            ->when(($filters['polres'] ?? '-') != '-', fn($q) => $q->where('polres.id', $filters['polres']))
            ->when(($filters['status'] ?? '-') != '-', fn($q) => $q->where('a.selra_flag', $filters['status']))
            ->when(($filters['tanggal'] ?? '-') != '-', fn($q) => $q->whereDate('a.accident_date', $filters['tanggal']))
            ->when(($filters['no_lp'] ?? '-') != '-', fn($q) => $q->where('a.no_lp', 'ILIKE', '%' . $filters['no_lp'] . '%'))
            ->when(($filters['level'] ?? null) == '1', fn($q) => $q->where('a.md', '>=', 1))
            ->when(($filters['level'] ?? null) == '2', fn($q) => $q->where('a.lb', '>=', 1)->where('a.md', 0))
            ->when(($filters['level'] ?? null) == '3', fn($q) => $q->where('a.lr', '>=', 1)->where('a.md', 0)->where('a.lb', 0));
    }

    protected function sidikQuery()
    {
        $user = Auth::user();
        $officerId = $user->register_number;

        return DB::table('doc.surat_perintah_penyidikan_documents as d')
            ->join('doc.surat_perintah_penyidikan_document_officers as e', 'd.id', '=', 'e.surat_perintah_penyidikan_document_id')
            ->where('e.register_number', $officerId)
            ->whereNull('d.deleted_at')
            ->select('d.accident_id')
            ->union(
                DB::table('legacy.investigation_warrants as f')
                    ->join('legacy.investigation_warrant_officer as g', 'f.id', '=', 'g.investigation_warrant_id')
                    ->where('g.officer_id', $officerId)
                    ->select('f.accident_id')
            )
            ->union(
                DB::table('public.surat_penyidikan as k')
                    ->where('k.officer_id', $officerId)
                    ->select('k.accident_id')
            );
    }

    protected function lidikQuery()
    {
        $user = Auth::user();
        $officerId = $user->register_number;

        return DB::table('doc.surat_perintah_penyelidikan_documents as b')
            ->join('doc.surat_perintah_penyelidikan_document_officers as c', 'b.id', '=', 'c.surat_perintah_penyelidikan_document_id')
            ->where('c.register_number', $officerId)
            ->whereNull('b.deleted_at')
            ->select('b.accident_id')
            ->union(
                DB::table('legacy.investigation_order_letters as h')
                    ->join('legacy.investigation_order_letter_officer as i', 'h.id', '=', 'i.investigation_order_letter_id')
                    ->where('i.officer_id', $officerId)
                    ->select('h.accident_id')
            )

            ->union(
                DB::table('public.surat_penyelidikan as j')
                    ->where('j.officer_id', $officerId)
                    ->select('j.accident_id')
            );
    }


    protected function allSidikQuery()
    {
        return DB::table('doc.surat_perintah_penyidikan_documents as d')
            ->select('d.accident_id')
            ->union(DB::table('legacy.investigation_warrants as f')->select('f.accident_id'))
            ->union(DB::table('public.surat_penyidikan as k')->select('k.accident_id'));
    }

    protected function allLidikQuery()
    {
        return DB::table('doc.surat_perintah_penyelidikan_documents as b')
            ->select('b.accident_id')
            ->union(DB::table('legacy.investigation_order_letters as h')->select('h.accident_id'))
            ->union(DB::table('public.surat_penyelidikan as j')->select('j.accident_id'));
    }


    protected function statusAccidents()
    {
        $getSidiks = DB::table('doc.surat_perintah_penyidikan_documents as spd')
            ->join('doc.surat_perintah_penyidikan_document_officers as spdo', 'spd.id', '=', 'spdo.surat_perintah_penyidikan_document_id')
            ->select(
                'spd.accident_id',
                DB::raw("'sidik' as status"),
                DB::raw("TRUE as status_sidik"),
                'spdo.register_number'
            )
            ->union(
                DB::table('legacy.investigation_warrants as iw')
                    ->join('legacy.investigation_warrant_officer as iwo', 'iw.id', '=', 'iwo.investigation_warrant_id')
                    ->select(
                        'iw.accident_id',
                        DB::raw("'sidik' as status"),
                        DB::raw("TRUE as status_sidik"),
                        'iwo.officer_id as register_number'
                    )
            )
            ->union(
                DB::table('public.surat_penyidikan as sp')
                    ->select(
                        'sp.accident_id',
                        DB::raw("'sidik' as status"),
                        DB::raw("TRUE as status_sidik"),
                        'sp.officer_id as register_number'
                    )
            );

        $getLidiks = DB::table('doc.surat_perintah_penyelidikan_documents as spl')
            ->join('doc.surat_perintah_penyelidikan_document_officers as splo', 'spl.id', '=', 'splo.surat_perintah_penyelidikan_document_id')
            ->select(
                'spl.accident_id',
                DB::raw("'lidik' as status"),
                DB::raw("FALSE as status_sidik"),
                'splo.register_number'
            )
            ->union(
                DB::table('legacy.investigation_order_letters as iol')
                    ->join('legacy.investigation_order_letter_officer as iolo', 'iol.id', '=', 'iolo.investigation_order_letter_id')
                    ->select(
                        'iol.accident_id',
                        DB::raw("'lidik' as status"),
                        DB::raw("FALSE as status_sidik"),
                        'iolo.officer_id as register_number'
                    )
            )
            ->union(
                DB::table('public.surat_penyelidikan as s')
                    ->select(
                        's.accident_id',
                        DB::raw("'lidik' as status"),
                        DB::raw("FALSE as status_sidik"),
                        's.officer_id as register_number'
                    )
            );

        $unionGet = $getLidiks->union($getSidiks);

        return DB::query()->fromSub($unionGet, 'x');
    }

    protected function filterSearchAccident($polda, $polres, $checkTanggal, $checkstatus, $tanggal, $no_lp, $level)
    {
        $filters = [];

        if ($polda !== '-' && !empty($polda)) {
            $filters[] = "polda.id = '$polda'";
        }
        if ($polres !== '-' && !empty($polres)) {
            $filters[] = "polres.id = '$polres'";
        }
        if ($checkstatus !== '-' && !empty($checkstatus)) {
            $filters[] = "acc.selra_flag = '$checkstatus'";
        }
        if ($checkTanggal !== '-' && !empty($checkTanggal)) {
            $filters[] = "acc.accident_date = '$tanggal'";
        }
        if ($no_lp !== '-' && !empty($no_lp)) {
            $filters[] = "acc.no_lp ILIKE '%$no_lp%'";
        }
        if ($level === 1) {
            $filters[] = "acc.md >= 1";
        } else if ($level === 2) {
            $filters[] = "acc.lb >=1 AND acc.md = 0";
        } else if ($level === 3) {
            $filters[] = "acc.lr >=1 AND acc.lb = 0 AND acc.md = 0";
        }

        return $filters ? implode(' AND ', $filters) : 'TRUE';
    }

    protected function getStatusAcc($polresId, $officerId)
    {
        $query =
            "
            SELECT acc.id, polda.name as polda_name, polres.name as polres_name,
            ref.id as selra_id, rank_id, acc.no_lp ,md, lb, lr, road_name ,
            to_char(acc.accident_date, 'DD-MM-YYYY') as accident_date  , ref.name as selra,
            to_char(acc.last_update, 'DD-MM-YYYY HH24:ii:ss') as accident_last_update,
            CONCAT(officer_first_name, ' ',officer_last_name) as officer_name
            FROM accidents as acc
            LEFT JOIN ref ON acc.selra_flag = ref.id
            LEFT JOIN polres ON acc.polres_id = polres.id
            LEFT JOIN polda ON polda.id = polres.polda_id
            LEFT JOIN (
                SELECT a.accident_id, 'lidik' as status, b.register_number
                FROM doc.surat_perintah_penyelidikan_documents as a
                JOIN doc.surat_perintah_penyelidikan_document_officers as b
                    ON a.id = b.surat_perintah_penyelidikan_document_id
                WHERE b.register_number = ?
                UNION
                SELECT c.accident_id, 'lidik' as status, d.officer_id as register_number
                FROM legacy.investigation_order_letters as c
                JOIN legacy.investigation_order_letter_officer as d
                    ON c.id = d.investigation_order_letter_id
                WHERE d.officer_id = ?
                UNION
                SELECT e.accident_id, 'lidik' as status, e.officer_id as register_number
                FROM public.surat_penyelidikan as e
                WHERE e.officer_id = ?

                UNION

                SELECT f.accident_id, 'sidik' as status, g.register_number
                FROM doc.surat_perintah_penyidikan_documents as f
                JOIN doc.surat_perintah_penyidikan_document_officers as g
                    ON f.id = g.surat_perintah_penyidikan_document_id
                WHERE g.register_number = ?
                UNION
                SELECT h.accident_id, 'sidik' as status, i.officer_id as register_number
                FROM legacy.investigation_warrants as h
                JOIN legacy.investigation_warrant_officer as i
                    ON h.id = i.investigation_warrant_id
                WHERE i.officer_id = ?
                UNION
                SELECT j.accident_id, 'sidik' as status, j.officer_id as register_number
                FROM surat_penyidikan as j
                WHERE j.officer_id = ?
            ) AS x ON acc.id = x.accident_id
            WHERE acc.polres_id = ?
            AND (
                (
                    (
                        EXISTS (
                            SELECT 1 FROM doc.surat_perintah_penyidikan_documents as spd
                            WHERE spd.accident_id = acc.id
                        )
                        OR EXISTS (
                            SELECT 1 FROM legacy.investigation_warrants as iw
                            WHERE iw.accident_id = acc.id
                        ) OR EXISTS (
                            SELECT 1 FROM surat_penyidikan sp
                            WHERE sp.accident_id = acc.id
                        )
                    ) AND x.status = 'sidik'
                ) OR (
                    (
                        NOT EXISTS (
                            SELECT 1 FROM doc.surat_perintah_penyidikan_documents as spd
                            WHERE spd.accident_id = acc.id
                        ) AND NOT EXISTS (
                            SELECT 1 FROM legacy.investigation_warrants as iw
                            WHERE iw.accident_id = acc.id
                        ) AND NOT EXISTS (
                            SELECT 1 FROM surat_penyidikan sp
                            WHERE sp.accident_id = acc.id
                        )
                    ) AND x.status = 'lidik'
                ) OR (
                    NOT EXISTS (
                        SELECT 1 FROM doc.surat_perintah_penyidikan_documents as spd
                        WHERE spd.accident_id = acc.id
                    ) AND NOT EXISTS (
                        SELECT 1 FROM legacy.investigation_warrants as iw
                        WHERE iw.accident_id = acc.id
                    ) AND NOT EXISTS (
                        SELECT 1 FROM surat_penyidikan sp
                        WHERE sp.accident_id = acc.id
                    )
                )
            )
            ORDER BY acc.created_at DESC
            ";

        // dd($query);
        return DB::select($query, [
            $officerId, $officerId, $officerId,
            $officerId, $officerId, $officerId,
            $polresId]);
    }

    protected function searchGetAccident($officerId, $polda, $polres, $checkTanggal, $checkstatus, $tanggal, $no_lp, $level)
    {
        // $user = Auth::user();
        // $officerId = $user->register_number;
        $filtered = $this->filterSearchAccident($polda, $polres, $checkTanggal, $checkstatus, $tanggal, $no_lp, $level);

        $query =
            "
            SELECT acc.id, polda.name as polda_name, polres.name as polres_name,
            ref.id as selra_id, rank_id, acc.no_lp ,md, lb, lr, road_name ,
            to_char(acc.accident_date, 'DD-MM-YYYY') as accident_date  , ref.name as selra,
            to_char(acc.last_update, 'DD-MM-YYYY HH24:ii:ss') as accident_last_update,
            CONCAT(officer_first_name, ' ',officer_last_name) as officer_name, x.register_number
            FROM accidents as acc
            LEFT JOIN ref ON acc.selra_flag = ref.id
            LEFT JOIN polres ON acc.polres_id = polres.id
            LEFT JOIN polda ON polda.id = polres.polda_id
            LEFT JOIN (
                SELECT a.accident_id, 'lidik' as status, b.register_number
                FROM doc.surat_perintah_penyelidikan_documents as a
                JOIN doc.surat_perintah_penyelidikan_document_officers as b
                    ON a.id = b.surat_perintah_penyelidikan_document_id
                WHERE b.register_number = ?
                UNION
                SELECT c.accident_id, 'lidik' as status, d.officer_id as register_number
                FROM legacy.investigation_order_letters as c
                JOIN legacy.investigation_order_letter_officer as d
                    ON c.id = d.investigation_order_letter_id
                WHERE d.officer_id = ?
                UNION
                SELECT e.accident_id, 'lidik' as status, e.officer_id as register_number
                FROM public.surat_penyelidikan as e
                WHERE e.officer_id = ?

                UNION

                SELECT f.accident_id, 'sidik' as status, g.register_number
                FROM doc.surat_perintah_penyidikan_documents as f
                JOIN doc.surat_perintah_penyidikan_document_officers as g
                    ON f.id = g.surat_perintah_penyidikan_document_id
                WHERE g.register_number = ?
                UNION
                SELECT h.accident_id, 'sidik' as status, i.officer_id as register_number
                FROM legacy.investigation_warrants as h
                JOIN legacy.investigation_warrant_officer as i
                    ON h.id = i.investigation_warrant_id
                WHERE i.officer_id = ?
                UNION
                SELECT j.accident_id, 'sidik' as status, j.officer_id as register_number
                FROM surat_penyidikan as j
                WHERE j.officer_id = ?
            ) AS x ON acc.id = x.accident_id
            WHERE $filtered
            AND
            (
                (
                    (
                        EXISTS (
                            SELECT 1 FROM doc.surat_perintah_penyidikan_documents as spd
                            WHERE spd.accident_id = acc.id
                        )
                        OR EXISTS (
                            SELECT 1 FROM legacy.investigation_warrants as iw
                            WHERE iw.accident_id = acc.id
                        ) OR EXISTS (
                            SELECT 1 FROM surat_penyidikan sp
                            WHERE sp.accident_id = acc.id
                        )
                    ) AND x.status = 'sidik'
                ) OR (
                    (
                        NOT EXISTS (
                            SELECT 1 FROM doc.surat_perintah_penyidikan_documents as spd
                            WHERE spd.accident_id = acc.id
                        ) AND NOT EXISTS (
                            SELECT 1 FROM legacy.investigation_warrants as iw
                            WHERE iw.accident_id = acc.id
                        ) AND NOT EXISTS (
                            SELECT 1 FROM surat_penyidikan sp
                            WHERE sp.accident_id = acc.id
                        )
                    ) AND x.status = 'lidik'
                ) OR (
                    NOT EXISTS (
                        SELECT 1 FROM doc.surat_perintah_penyidikan_documents as spd
                        WHERE spd.accident_id = acc.id
                    ) AND NOT EXISTS (
                        SELECT 1 FROM legacy.investigation_warrants as iw
                        WHERE iw.accident_id = acc.id
                    ) AND NOT EXISTS (
                        SELECT 1 FROM surat_penyidikan sp
                        WHERE sp.accident_id = acc.id
                    )
                )
            )
            ORDER BY acc.created_at DESC
            ";

        // dd($query);

        return DB::select($query, [
            $officerId, $officerId, $officerId,
            $officerId, $officerId, $officerId
        ]);
    }

    protected function getEffectivePolresId($userPolresId)
    {
        if($userPolresId == 0){
            return [0];
        }

        $mapped = DB::table('polres_migration_history')
            ->where('old_police_id', $userPolresId)
            ->orWhere('new_police_id', $userPolresId)
            ->first();

        if ($mapped) {
            return [
                $mapped->old_police_id, $mapped->new_police_id
            ];
        }

        return [$userPolresId];
    } 

    protected function getEffectivePoldaId($userPoldaId)
    {
        if($userPoldaId == 0){
            return [0];
        }

        $mapped = DB::table('polres_migration_history')
            ->where('old_polda_id', $userPoldaId)
            ->orWhere('new_polda_id', $userPoldaId)
            ->first();

        if ($mapped) {
            return [
                $mapped->old_polda_id, $mapped->new_polda_id
            ];
        }

        return [$userPoldaId];
    } 

    public function getUserHasOldPolresId($userPolresId)
    {
        return DB::table('polres_migration_history')
            ->where('old_police_id', $userPolresId)
            ->exists();
    }
}
